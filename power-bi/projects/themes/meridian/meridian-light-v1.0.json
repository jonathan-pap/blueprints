{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.152.json",
  "name": "Meridian Light v1.0",
  "dataColors": [
    "#4F44C9",
    "#8A691A",
    "#2A9085",
    "#D46AD4",
    "#277046",
    "#CA4A6A",
    "#4C8FD2",
    "#464C59"
  ],
  "good": "#277046",
  "bad": "#CA4A6A",
  "neutral": "#464C59",
  "maximum": "#4F44C9",
  "center": "#E9EDF3",
  "minimum": "#CA4A6A",
  "null": "#798190",
  "foreground": "#101623",
  "foregroundNeutralSecondary": "#454E60",
  "foregroundLight": "#666F81",
  "foregroundNeutralTertiary": "#798190",
  "foregroundDark": "#101623",
  "background": "#FFFFFF",
  "backgroundLight": "#F5F7FA",
  "backgroundNeutral": "#E9EDF3",
  "backgroundDark": "#DCE2EB",
  "tableAccent": "#4F44C9",
  "hyperlink": "#4F44C9",
  "shapeStroke": "#E2E7EF",
  "accent": "#4F44C9",
  "textClasses": {
    "callout": {
      "color": "#101623",
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28
    },
    "largeTitle": {
      "color": "#101623",
      "fontFace": "Segoe UI Semibold",
      "fontSize": 18
    },
    "title": {
      "color": "#101623",
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12
    },
    "header": {
      "color": "#101623",
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10
    },
    "label": {
      "color": "#454E60",
      "fontFace": "Segoe UI",
      "fontSize": 9
    },
    "boldLabel": {
      "color": "#101623",
      "fontFace": "Segoe UI Semibold",
      "fontSize": 9
    },
    "dataTitle": {
      "color": "#666F81",
      "fontFace": "Segoe UI",
      "fontSize": 10
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E7EF"
              }
            },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#101623"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "alignment": "left"
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#101623"
              }
            },
            "transparency": 0,
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#E2E7EF"
              }
            },
            "titleSize": 13,
            "headerSize": 11,
            "fontFamily": "Segoe UI",
            "checkboxAndApplyColor": {
              "solid": {
                "color": "#4F44C9"
              }
            },
            "inputBoxColor": {
              "solid": {
                "color": "#E9EDF3"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "foregroundColor": {
              "solid": {
                "color": "#101623"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#E9EDF3"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#E2E7EF"
              }
            },
            "transparency": 0,
            "inputBoxColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI"
          },
          {
            "$id": "Available",
            "foregroundColor": {
              "solid": {
                "color": "#454E60"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#E2E7EF"
              }
            },
            "transparency": 0,
            "inputBoxColor": {
              "solid": {
                "color": "#E9EDF3"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "image": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "shape": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "padding": [
          {
            "top": 4,
            "bottom": 4,
            "left": 8,
            "right": 8
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "textSize": 9,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#666F81"
              }
            },
            "showRestatement": false
          }
        ],
        "items": [
          {
            "textSize": 10,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#101623"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "padding": 4
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
