{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.152.json",
  "name": "Verdigris Arcanum (Dark)",
  "dataColors": [
    "#3FA9A0",
    "#D9B96A",
    "#4F86CF",
    "#4AC5BB",
    "#C9712D",
    "#9B6FD0",
    "#C24A4A",
    "#6A9FB0"
  ],
  "good": "#4AC5BB",
  "neutral": "#A6873F",
  "bad": "#C24A4A",
  "maximum": "#3FA9A0",
  "center": "#16243C",
  "minimum": "#C24A4A",
  "null": "#3A5E5A",
  "foreground": "#D3EAE6",
  "foregroundNeutralSecondary": "#6FB8B0",
  "foregroundLight": "#4E8B84",
  "foregroundNeutralTertiary": "#3A5E5A",
  "foregroundDark": "#D3EAE6",
  "background": "#0E1A2E",
  "backgroundLight": "#070C16",
  "backgroundNeutral": "#16243C",
  "backgroundDark": "#050810",
  "tableAccent": "#3FA9A0",
  "hyperlink": "#4AC5BB",
  "shapeStroke": "#2F8E86",
  "accent": "#3FA9A0",
  "textClasses": {
    "callout": {
      "color": "#D3EAE6",
      "fontFace": "Segoe UI",
      "fontSize": 28
    },
    "title": {
      "color": "#D3EAE6",
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12
    },
    "header": {
      "color": "#D3EAE6",
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10
    },
    "label": {
      "color": "#6FB8B0",
      "fontFace": "Segoe UI",
      "fontSize": 9
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0E1A2E"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#B8923C"
              }
            },
            "radius": 5
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#D3EAE6"
              }
            },
            "background": {
              "solid": {
                "color": "#0E1A2E"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "alignment": "left"
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#070C16"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#D3EAE6"
              }
            },
            "transparency": 0,
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#2F8E86"
              }
            },
            "titleSize": 13,
            "headerSize": 11,
            "fontFamily": "Segoe UI",
            "checkboxAndApplyColor": {
              "solid": {
                "color": "#3FA9A0"
              }
            },
            "inputBoxColor": {
              "solid": {
                "color": "#16243C"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#070C16"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#070C16"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
