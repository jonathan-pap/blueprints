{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.152.json",
  "name": "Deep Space (Dark)",
  "dataColors": [
    "#4CC9F0",
    "#9D7BEA",
    "#F2A93B",
    "#E05A8A",
    "#2DC7A6",
    "#4F7BE0",
    "#9FC0E8",
    "#C96A45"
  ],
  "good": "#2DC7A6",
  "neutral": "#7C87A6",
  "bad": "#E0555F",
  "maximum": "#4CC9F0",
  "center": "#1A2340",
  "minimum": "#E0555F",
  "null": "#6E7896",
  "foreground": "#E8ECF8",
  "foregroundNeutralSecondary": "#B9C2DA",
  "foregroundLight": "#8892AE",
  "foregroundNeutralTertiary": "#6E7896",
  "foregroundDark": "#E8ECF8",
  "background": "#0F1528",
  "backgroundLight": "#070B18",
  "backgroundNeutral": "#1A2340",
  "backgroundDark": "#04070F",
  "tableAccent": "#4CC9F0",
  "hyperlink": "#4CC9F0",
  "shapeStroke": "#26304F",
  "accent": "#4CC9F0",
  "textClasses": {
    "callout": {
      "color": "#E8ECF8",
      "fontFace": "Segoe UI",
      "fontSize": 28
    },
    "title": {
      "color": "#E8ECF8",
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12
    },
    "header": {
      "color": "#E8ECF8",
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10
    },
    "label": {
      "color": "#B9C2DA",
      "fontFace": "Segoe UI",
      "fontSize": 9
    },
    "dataTitle": {
      "color": "#8892AE",
      "fontFace": "Segoe UI",
      "fontSize": 10
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0F1528"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#26304F"
              }
            },
            "radius": 5
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#E8ECF8"
              }
            },
            "background": {
              "solid": {
                "color": "#0F1528"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "alignment": "left"
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#070B18"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#E8ECF8"
              }
            },
            "transparency": 0,
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#26304F"
              }
            },
            "titleSize": 13,
            "headerSize": 11,
            "fontFamily": "Segoe UI",
            "checkboxAndApplyColor": {
              "solid": {
                "color": "#4CC9F0"
              }
            },
            "inputBoxColor": {
              "solid": {
                "color": "#1A2340"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "foregroundColor": {
              "solid": {
                "color": "#E8ECF8"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#1A2340"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#26304F"
              }
            },
            "transparency": 0,
            "inputBoxColor": {
              "solid": {
                "color": "#0F1528"
              }
            },
            "fontFamily": "Segoe UI"
          },
          {
            "$id": "Available",
            "foregroundColor": {
              "solid": {
                "color": "#B9C2DA"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#0F1528"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#26304F"
              }
            },
            "transparency": 0,
            "inputBoxColor": {
              "solid": {
                "color": "#1A2340"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "image": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#070B18"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#070B18"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}