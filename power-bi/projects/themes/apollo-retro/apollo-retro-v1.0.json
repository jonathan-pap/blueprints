{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.152.json",
  "name": "Apollo Retro (Light)",
  "dataColors": [
    "#E0532F",
    "#21365E",
    "#3E7CC4",
    "#6B7280",
    "#A67C1E",
    "#3F8A63",
    "#8C5AA0",
    "#B0703A"
  ],
  "good": "#3F8A63",
  "neutral": "#6B7280",
  "bad": "#C0392B",
  "maximum": "#E0532F",
  "center": "#EAE5D9",
  "minimum": "#C0392B",
  "null": "#8B919C",
  "foreground": "#1C2333",
  "foregroundNeutralSecondary": "#3E4759",
  "foregroundLight": "#656B7A",
  "foregroundNeutralTertiary": "#8B919C",
  "foregroundDark": "#1C2333",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F1EA",
  "backgroundNeutral": "#EAE5D9",
  "backgroundDark": "#DCD5C4",
  "tableAccent": "#E0532F",
  "hyperlink": "#E0532F",
  "shapeStroke": "#D8D2C4",
  "accent": "#E0532F",
  "textClasses": {
    "callout": {
      "color": "#1C2333",
      "fontFace": "Segoe UI",
      "fontSize": 28
    },
    "title": {
      "color": "#1C2333",
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12
    },
    "header": {
      "color": "#1C2333",
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10
    },
    "label": {
      "color": "#3E4759",
      "fontFace": "Segoe UI",
      "fontSize": 9
    },
    "dataTitle": {
      "color": "#656B7A",
      "fontFace": "Segoe UI",
      "fontSize": 10
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D8D2C4"
              }
            },
            "radius": 5
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1C2333"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "alignment": "left"
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#F4F1EA"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#1C2333"
              }
            },
            "transparency": 0,
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#D8D2C4"
              }
            },
            "titleSize": 13,
            "headerSize": 11,
            "fontFamily": "Segoe UI",
            "checkboxAndApplyColor": {
              "solid": {
                "color": "#E0532F"
              }
            },
            "inputBoxColor": {
              "solid": {
                "color": "#EAE5D9"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "foregroundColor": {
              "solid": {
                "color": "#1C2333"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#EAE5D9"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#D8D2C4"
              }
            },
            "transparency": 0,
            "inputBoxColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI"
          },
          {
            "$id": "Available",
            "foregroundColor": {
              "solid": {
                "color": "#3E4759"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#D8D2C4"
              }
            },
            "transparency": 0,
            "inputBoxColor": {
              "solid": {
                "color": "#EAE5D9"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "image": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F1EA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F1EA"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}