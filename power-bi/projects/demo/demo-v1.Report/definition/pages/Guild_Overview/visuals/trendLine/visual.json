            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Total Bounty"
                }
              },
              "queryRef": "_Measures.Total Bounty",
              "nativeQueryRef": "Total Bounty"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
