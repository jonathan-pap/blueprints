table _Measures
	isHidden
	lineageTag: cfff4bff-9707-4543-823b-798f2f9200bb

	/// [Type: other, Created on: 2026-08-16, Created by: JPA]
	measure _blank = ""
		lineageTag: 863ebf9f-9c98-499d-b9fa-e9869f89a6c0

	/// [Type: other, Created on: 2026-08-16, Created by: JPA]
	measure test =
			var _test = "test"
			RETURN
			_test
		lineageTag: 50f5ee3d-1c94-4436-846a-df61a8d6ab39

	/// Launch count - the column height on the cadence chart.
	measure Launches = COUNTROWS ( space_missions )
		formatString: #,##0
		lineageTag: 1dab2b25-78bf-4bfa-982e-5bf90ca8bd5f

	/// Recipe primitive P2 - harvests the disconnected Decades selection. Returns 1 when nothing is selected so the resting state is all-bright, not all-dimmed.
	measure 'Is Selected Decade' =
			VAR _sel = VALUES ( Decades[Decade] )
			VAR _d = SELECTEDVALUE ( DimDate[Decade] )
			RETURN
			    INT ( NOT ISFILTERED ( Decades[Decade] ) || _d IN _sel )
		formatString: 0
		isHidden
		lineageTag: c94bccff-78ea-4a99-9d81-5b7d5ae5c5c4

	/// Recipe primitive P4 - spotlight colour bound to dataPoint.fill. Ion cyan when in the selected decade, neutral grey otherwise. 2022 gets desaturated variants because it is a partial year (data ends 2022-07-29). MUST be bound with a dataViewWildcard selector or every column renders identically.
	measure 'Column Color' =
			VAR _sel = [Is Selected Decade]
			VAR _y = SELECTEDVALUE ( DimDate[Year] )
			VAR _partial = _y = 2022
			RETURN
			    SWITCH (
			        TRUE (),
			        _partial && _sel = 1, "#2A6F87",
			        _partial, "#3F4657",
			        _sel = 1, "#4CC9F0",
			        "#7C87A6"
			    )
		isHidden
		lineageTag: d521adac-8cb5-4f6e-ae04-b8fc8deb1126

	/// Marker Y-position - sits on top of the column for any year carrying a derived event. Blank elsewhere, so the marker series only draws on event years.
	measure 'Event Marker' =
			VAR _y = SELECTEDVALUE ( DimDate[Year] )
			VAR _has = COUNTROWS ( FILTER ( Events, Events[EventYear] = _y ) )
			RETURN
			    IF ( NOT ISBLANK ( _has ), [Launches] )
		formatString: #,##0
		lineageTag: a7c8f2b9-acc8-477a-ac3e-8697a4b49028

	/// Event text for a year, blank unless a decade is actually selected - keeps all 19 labels from rendering at once. Multiple events in one year are newline-joined.
	measure 'Event Label' =
			VAR _y = SELECTEDVALUE ( DimDate[Year] )
			VAR _labels =
			    CONCATENATEX (
			        FILTER ( Events, Events[EventYear] = _y ),
			        Events[EventLabel],
			        UNICHAR ( 10 )
			    )
			RETURN
			    IF ( [Is Selected Decade] = 1 && ISFILTERED ( Decades[Decade] ), _labels )
		lineageTag: 3d8fc433-f5d8-47a9-8d2c-d745100e5f9d

	column _
		isHidden
		lineageTag: 664b670f-5eba-42a4-a1b0-bd68e0351e73
		isNameInferred
		sourceColumn: [_]

	partition _Measures = calculated
		mode: import
		source = ROW("_", "")

	annotation PBI_ResultType = Table

