			    & "<rect width='1280' height='720' filter='url(#v)' opacity='0.6'/>"
			    & "<g fill='#E8ECF8'>"
			    & "<circle cx='58' cy='96' r='0.8' opacity='.45'/><circle cx='143' cy='612' r='1' opacity='.6'/><circle cx='207' cy='58' r='.7' opacity='.35'/><circle cx='268' cy='430' r='1.1' opacity='.55'/><circle cx='321' cy='176' r='.6' opacity='.3'/>"
			    & "<circle cx='389' cy='667' r='.9' opacity='.5'/><circle cx='432' cy='302' r='.7' opacity='.4'/><circle cx='487' cy='81' r='1.2' opacity='.65'/><circle cx='534' cy='523' r='.6' opacity='.32'/><circle cx='596' cy='241' r='.9' opacity='.48'/>"
			    & "<circle cx='641' cy='694' r='.8' opacity='.42'/><circle cx='702' cy='132' r='1' opacity='.58'/><circle cx='757' cy='389' r='.7' opacity='.36'/><circle cx='812' cy='605' r='1.1' opacity='.6'/><circle cx='868' cy='46' r='.6' opacity='.3'/>"
