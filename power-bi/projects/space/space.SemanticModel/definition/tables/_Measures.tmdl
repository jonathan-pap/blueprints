			    & "</svg>"
		isHidden
		lineageTag: ada3276c-0aed-45c4-b019-f9a2dd72a834
		dataCategory: ImageUrl

	/// Serpentine X position for the timeline scatter. Pairs with [Node Y]. The scatter's categoryAxis MUST stay pinned to the window -1.4 .. (PerRow-1)+1.4 or the nodes will not sit on the [Timeline Ribbon] path behind them.
	measure 'Node X' = SELECTEDVALUE ( TimelineNodes[NodeCol] )
		formatString: 0.0
		lineageTag: f70e0209-fdc7-474a-b776-52baa796db80

	/// Serpentine Y position (negated so row 0 is the TOP band). The scatter's valueAxis MUST stay pinned to -(RowCount-1)-0.6 .. 0.6 to match [Timeline Ribbon].
	measure 'Node Y' = -1 * SELECTEDVALUE ( TimelineNodes[NodeRow] )
		formatString: 0.0
		lineageTag: d9153a87-6245-4d8d-a984-81afd506c68f

	/// Bubble size for the timeline scatter - launches in that year. The '+ 0' keeps a node visible for a year with no launches instead of dropping the point.
	measure 'Node Size' = [Launches] + 0
		formatString: #,0
		lineageTag: 304a1954-caca-4297-8da5-91a5e772c28c

	/// Per-node fill for the timeline scatter - amber on a milestone year, cyan otherwise. Bind through dataPoint.fill with a dataViewWildcard selector (same pattern as the cadence chart's [Column Color]).
	measure 'Node Color' =
			VAR _y = SELECTEDVALUE ( TimelineNodes[Year] )
			VAR _isEvent = _y IN DISTINCT ( ALL ( Events[EventYear] ) )
			RETURN
			    IF ( _isEvent, "#F2A93B", "#4CC9F0" )
		lineageTag: f2f21381-0496-4849-a6fe-e88c1aa498ce

	/// Static SVG connector for the serpentine timeline - the horizontal band lines plus the U-turn arcs that no native Power BI visual can draw. Rendered in an image visual (sourceType 'imageData') sitting BEHIND the node scatter. Geometry is expressed in the image visual's own pixel space (viewBox 0 0 1200 430, preserveAspectRatio 'none'), and is mapped from the SAME axis window the scatter is pinned to - change one and you must change the other. NOTE: every coordinate goes through FORMAT(ROUND(x,0),"0") because a locale that uses a comma as the decimal separator would otherwise emit '1110,6' into the path data and silently break the SVG.
	measure 'Timeline Ribbon' =
			VAR _rows = MAXX ( ALL ( TimelineNodes ), TimelineNodes[RowCount] )
			VAR _perRow = MAXX ( ALL ( TimelineNodes ), TimelineNodes[PerRow] )
			VAR _W = 1200
			VAR _H = 430
			VAR _xMin = -1.4
			VAR _xMax = _perRow - 1 + 1.4
			VAR _yMax = 0.6
			VAR _yMin = - ( _rows - 1 ) - 0.6
			VAR _sx = DIVIDE ( _W, _xMax - _xMin )
			VAR _sy = DIVIDE ( _H, _yMax - _yMin )
			VAR _rx = 46
			VAR _ry = _sy / 2
			VAR _bands =
			    GROUPBY (
			        ALL ( TimelineNodes ),
			        TimelineNodes[NodeRow],
			        "@lo", MINX ( CURRENTGROUP (), TimelineNodes[NodeCol] ),
			        "@hi", MAXX ( CURRENTGROUP (), TimelineNodes[NodeCol] )
			    )
			VAR _lines =
			    CONCATENATEX (
			        _bands,
			        VAR _y = FORMAT ( ROUND ( ( _yMax + TimelineNodes[NodeRow] ) * _sy, 0 ), "0" )
			        RETURN
			            "<path d='M " & FORMAT ( ROUND ( ( [@lo] - _xMin ) * _sx, 0 ), "0" ) & "," & _y
			                & " L " & FORMAT ( ROUND ( ( [@hi] - _xMin ) * _sx, 0 ), "0" ) & "," & _y & "'/>",
			        ""
			    )
			VAR _turns =
			    CONCATENATEX (
			        FILTER ( _bands, TimelineNodes[NodeRow] < _rows - 1 ),
			        VAR _r = TimelineNodes[NodeRow]
			        VAR _right = MOD ( _r, 2 ) = 0
			        VAR _x = FORMAT ( ROUND ( ( IF ( _right, _perRow - 1, 0 ) - _xMin ) * _sx, 0 ), "0" )
			        RETURN
			            "<path d='M " & _x & "," & FORMAT ( ROUND ( ( _yMax + _r ) * _sy, 0 ), "0" )
			                & " A " & _rx & " " & FORMAT ( ROUND ( _ry, 0 ), "0" ) & " 0 0 "
			                & IF ( _right, "1", "0" ) & " "
			                & _x & "," & FORMAT ( ROUND ( ( _yMax + _r + 1 ) * _sy, 0 ), "0" ) & "'/>",
			        ""
			    )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1200 430' preserveAspectRatio='none'>"
			        & "<g fill='none' stroke='#7C87A6' stroke-width='2' stroke-opacity='0.45' stroke-linecap='round' stroke-dasharray='1 6'>"
			        & _lines & _turns
			        & "</g></svg>"
		lineageTag: be87d75b-c18f-4a51-a790-57684e5c9675
		dataCategory: ImageUrl

	/// Canvas-tooltip body for the Mission Timeline nodes. Reads the hovered year from TimelineNodes. NOTE: the hovered node filters TimelineNodes which filters DimDate, so every 'across all years' calculation (rank, prior year, an operator's first-ever launch) must clear BOTH tables - ALL(DimDate) alone leaves it pinned to the hovered year, and ALL() will not take two tables so it has to be REMOVEFILTERS per call. Every TOPN carries a name tiebreaker, otherwise a tie returns several rows and CONCATENATEX glues them together. Literal words are never put inside FORMAT - letters there are read as format specifiers, which silently turned 'no change' into 'no chang' (the 'e' was eaten as an exponent marker).
	measure 'Timeline Tooltip' =
			VAR _y = COALESCE ( SELECTEDVALUE ( TimelineNodes[Year] ), SELECTEDVALUE ( DimDate[Year] ) )
			VAR _NL = UNICHAR ( 10 )
			VAR _TB = UNICHAR ( 9 )
			VAR _DOT = " " & UNICHAR ( 183 ) & " "
			VAR _n = [Launches] + 0
			VAR _prev =
			    CALCULATE (
			        COUNTROWS ( space_missions ),
			        REMOVEFILTERS ( DimDate ), REMOVEFILTERS ( TimelineNodes ),
			        DimDate[Year] = _y - 1
			    ) + 0
			VAR _minY = CALCULATE ( MIN ( DimDate[Year] ), REMOVEFILTERS ( DimDate ), REMOVEFILTERS ( TimelineNodes ) )
			VAR _diff = _n - _prev
			VAR _dTxt =
			    SWITCH (
			        TRUE (),
			        _y = _minY, "first year",
			        _diff = 0, "level with " & FORMAT ( _y - 1, "0" ),
			        IF ( _diff > 0, "+", "-" ) & FORMAT ( ABS ( _diff ), "#,##0" ) & " vs " & FORMAT ( _y - 1, "0" )
			    )
			VAR _years =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( DimDate[Year] ), REMOVEFILTERS ( DimDate ), REMOVEFILTERS ( TimelineNodes ) ),
			        "@n", CALCULATE ( COUNTROWS ( space_missions ), REMOVEFILTERS ( TimelineNodes ) )
			    )
			VAR _rank = COUNTROWS ( FILTER ( _years, [@n] > _n ) ) + 1
			VAR _ord =
			    SWITCH (
			        TRUE (),
			        MOD ( _rank, 100 ) IN { 11, 12, 13 }, "th",
			        MOD ( _rank, 10 ) = 1, "st",
			        MOD ( _rank, 10 ) = 2, "nd",
			        MOD ( _rank, 10 ) = 3, "rd",
			        "th"
			    )
			VAR _succ = CALCULATE ( COUNTROWS ( space_missions ), space_missions[MissionStatus] = "Success" ) + 0
			VAR _fail = CALCULATE ( COUNTROWS ( space_missions ), space_missions[MissionStatus] IN { "Failure", "Prelaunch Failure" } ) + 0
			VAR _nOp = DISTINCTCOUNT ( space_missions[Company] )
			VAR _nRk = DISTINCTCOUNT ( space_missions[Rocket] )
			VAR _nCn = DISTINCTCOUNT ( space_missions[SiteCountry] )
			VAR _topO =
			    CONCATENATEX (
			        TOPN ( 1, ADDCOLUMNS ( VALUES ( space_missions[Company] ), "@c", CALCULATE ( COUNTROWS ( space_missions ) ) ), [@c], DESC, space_missions[Company], ASC ),
			        space_missions[Company] & " (" & FORMAT ( [@c], "#,##0" ) & ")"
			    )
			VAR _topR =
			    CONCATENATEX (
			        TOPN ( 1, ADDCOLUMNS ( VALUES ( space_missions[Rocket] ), "@c", CALCULATE ( COUNTROWS ( space_missions ) ) ), [@c], DESC, space_missions[Rocket], ASC ),
			        space_missions[Rocket] & " (" & FORMAT ( [@c], "#,##0" ) & ")"
			    )
			VAR _topC =
			    CONCATENATEX (
			        TOPN ( 1, ADDCOLUMNS ( VALUES ( space_missions[SiteCountry] ), "@c", CALCULATE ( COUNTROWS ( space_missions ) ) ), [@c], DESC, space_missions[SiteCountry], ASC ),
			        space_missions[SiteCountry] & " (" & FORMAT ( [@c], "#,##0" ) & ")"
			    )
			VAR _firsts =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( space_missions[Company] ), REMOVEFILTERS ( DimDate ), REMOVEFILTERS ( TimelineNodes ) ),
			        "@fy", CALCULATE ( YEAR ( MIN ( space_missions[Date] ) ), REMOVEFILTERS ( DimDate ), REMOVEFILTERS ( TimelineNodes ) )
			    )
			VAR _new = FILTER ( _firsts, [@fy] = _y )
			VAR _newN = COUNTROWS ( _new ) + 0
			VAR _newTxt =
			    CONCATENATEX ( TOPN ( 3, _new, space_missions[Company], ASC ), space_missions[Company], ", " )
			        & IF ( _newN > 3, " +" & FORMAT ( _newN - 3, "0" ) & " more", "" )
			VAR _ev =
			    CONCATENATEX ( FILTER ( ALL ( Events ), Events[EventYear] = _y ), UNICHAR ( 8226 ) & " " & Events[EventLabel], _NL )
			VAR _head = FORMAT ( _y, "0" ) & IF ( _y = 2022, "   partial year", "" )
			VAR _body =
			    "Launches" & _TB & FORMAT ( _n, "#,##0" ) & _DOT & _dTxt & _NL
			        & "Rank" & _TB & FORMAT ( _rank, "0" ) & _ord & " busiest of " & FORMAT ( COUNTROWS ( _years ), "0" ) & _NL
			        & "Success" & _TB & FORMAT ( _succ, "#,##0" ) & " of " & FORMAT ( _n, "#,##0" ) & " (" & FORMAT ( DIVIDE ( _succ, _n ), "0.0%" ) & ")" & _NL
			        & "Failures" & _TB & FORMAT ( _fail, "#,##0" ) & _NL
			        & "Operators" & _TB & FORMAT ( _nOp, "0" ) & _DOT & "most " & _topO & _NL
			        & "Rockets" & _TB & FORMAT ( _nRk, "0" ) & _DOT & "most " & _topR & _NL
			        & "Launched from" & _TB & FORMAT ( _nCn, "0" ) & IF ( _nCn = 1, " country", " countries" ) & _DOT & "most " & _topC
			        & IF ( _newN > 0, _NL & "Debuts" & _TB & _newTxt, "" )
			RETURN
			    IF ( ISBLANK ( _y ), BLANK (), _head & _NL & _NL & _body & IF ( NOT ISBLANK ( _ev ), _NL & _NL & _ev, "" ) )
		lineageTag: 5e253caf-de09-404a-9848-868d73af4eee

