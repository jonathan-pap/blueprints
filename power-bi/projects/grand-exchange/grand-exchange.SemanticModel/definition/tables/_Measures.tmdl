table _Measures
	isHidden
	lineageTag: 70d50eba-454f-5579-8105-aeff160c829f

	/// Total gold value of all trades in context.
	measure 'Total Trade Value' = SUM ( FactTrade[TotalPrice] )
		formatString: "₡"#,##0
		displayFolder: 01. Headline
		lineageTag: 7ea0b6a4-3817-41db-b4ed-b90560059ec5

	/// Number of trade transactions.
	measure 'Trade Count' = COUNTROWS ( FactTrade )
		formatString: #,##0
		displayFolder: 01. Headline
		lineageTag: 309cfd7c-242d-489c-bcb1-45fc75ca5897

	/// Total units traded across all transactions.
	measure 'Trade Quantity' = SUM ( FactTrade[Quantity] )
		formatString: #,##0
		displayFolder: 01. Headline
		lineageTag: f810fbe5-343d-48a7-915a-a6b89330cf1d

	/// Distinct tradeable items that changed hands.
	measure 'Distinct Items Traded' = DISTINCTCOUNT ( FactTrade[ItemKey] )
		formatString: #,##0
		displayFolder: 01. Headline
		lineageTag: a0f07b73-c3a2-4c15-b006-3eede4ca4bf0

	/// Average gold value per trade.
	measure 'Avg Trade Value' = DIVIDE ( [Total Trade Value], [Trade Count] )
		formatString: "₡"#,##0
		displayFolder: 01. Headline
		lineageTag: 5d191261-0ca5-43f4-a7eb-b5f03effd467

	/// Active market listings (sum of daily snapshot).
	measure 'Active Listings' = SUM ( FactMarketPriceDaily[ListingsCount] )
		formatString: #,##0
		displayFolder: 01. Headline
		lineageTag: ff9af1f3-fd85-4487-a9e8-a3fd5c8c0eda

	/// Trade value year-to-date.
	measure 'Trade Value YTD' = CALCULATE ( [Total Trade Value], DATESYTD ( DimDate[Date] ) )
		formatString: "₡"#,##0
		displayFolder: 02. Time intelligence
		lineageTag: 74fb7ce2-cf29-4de5-b22a-091775ba7f41

	/// Trade value same period 1 year ago.
	measure 'Trade Value PY' = CALCULATE ( [Total Trade Value], SAMEPERIODLASTYEAR ( DimDate[Date] ) )
		formatString: "₡"#,##0
		displayFolder: 02. Time intelligence
		lineageTag: 054cd119-107d-48cb-9bff-a46cb7d129c5

	/// Trade value same period 2 years ago.
	measure 'Trade Value PY-2' = CALCULATE ( [Total Trade Value], DATEADD ( DimDate[Date], -2, YEAR ) )
		formatString: "₡"#,##0
		displayFolder: 02. Time intelligence
		lineageTag: c2d05e87-cd5b-430e-b38a-93e5aac147aa

	/// Trade value same period 3 years ago.
	measure 'Trade Value PY-3' = CALCULATE ( [Total Trade Value], DATEADD ( DimDate[Date], -3, YEAR ) )
		formatString: "₡"#,##0
		displayFolder: 02. Time intelligence
		lineageTag: c8c1ce1a-f021-479d-9eb2-62104271765e

	/// Trade value same period 4 years ago (2022 baseline).
	measure 'Trade Value PY-4' = CALCULATE ( [Total Trade Value], DATEADD ( DimDate[Date], -4, YEAR ) )
		formatString: "₡"#,##0
		displayFolder: 02. Time intelligence
		lineageTag: d68874de-26b6-4228-a4a7-3e3f946543aa

	/// Year-over-year growth.
	measure 'Trade Value YoY %' = DIVIDE ( [Total Trade Value] - [Trade Value PY], [Trade Value PY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02. Time intelligence
		lineageTag: 17732d1c-6061-4c9e-bb11-a88e053aa614

	/// 4-year compound annual growth rate (current vs PY-4).
	measure 'Trade Value 4Y CAGR %' = VAR _now = [Total Trade Value] VAR _then = [Trade Value PY-4] VAR _ratio = DIVIDE ( _now, _then ) RETURN IF ( _ratio > 0 && _then > 0, POWER ( _ratio, 0.25 ) - 1 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02. Time intelligence
		lineageTag: 0b8c287a-397b-4dfd-ba62-7ca01ece6974

	/// Trade value month-to-date.
	measure 'Trade Value MTD' = CALCULATE ( [Total Trade Value], DATESMTD ( DimDate[Date] ) )
		formatString: "₡"#,##0
		displayFolder: 02. Time intelligence
		lineageTag: 9a052970-469e-4653-8bd6-f1cef77b0859

	/// Trade value quarter-to-date.
	measure 'Trade Value QTD' = CALCULATE ( [Total Trade Value], DATESQTD ( DimDate[Date] ) )
		formatString: "₡"#,##0
		displayFolder: 02. Time intelligence
		lineageTag: f9e0bbc8-679f-4abc-80b7-80203721d472

	/// Trade value summed over the trailing 30 days.
	measure 'Trade Value Rolling 30D' = CALCULATE ( [Total Trade Value], DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ), -30, DAY ) )
		formatString: "₡"#,##0
		displayFolder: 02. Time intelligence
		lineageTag: e093b938-9f86-46a9-9b10-80929ec03bef

	/// Trade value summed over the trailing 90 days.
	measure 'Trade Value Rolling 90D' = CALCULATE ( [Total Trade Value], DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ), -90, DAY ) )
		formatString: "₡"#,##0
		displayFolder: 02. Time intelligence
		lineageTag: 413b31fe-3c53-4429-ade1-905f1775ee36

	/// Trade value summed over the trailing 365 days.
	measure 'Trade Value Rolling 365D' = CALCULATE ( [Total Trade Value], DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ), -365, DAY ) )
		formatString: "₡"#,##0
		displayFolder: 02. Time intelligence
		lineageTag: 2d5b9698-12f5-4d49-bb3b-dd814f8ed327

	/// Trade value in the 30 days ending 31 days before the current MAX date.
	measure 'Trade Value Prior 30D' = VAR _end = MAX ( DimDate[Date] ) - 30 RETURN CALCULATE ( [Total Trade Value], DATESINPERIOD ( DimDate[Date], _end, -30, DAY ) )
		formatString: "₡"#,##0
		displayFolder: 03. Momentum
		lineageTag: f8d3ed2d-56bf-4b69-bd13-ef6c7bf1cd75

	/// % change between trailing 30D and the prior 30D — short-term momentum.
	measure '30D Momentum %' = DIVIDE ( [Trade Value Rolling 30D] - [Trade Value Prior 30D], [Trade Value Prior 30D] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03. Momentum
		lineageTag: 45c91ab3-8597-4e04-8ad3-f308e1b649bc

	/// Days since the most recent trade in context.
	measure 'Days Since Last Trade' = VAR _last = CALCULATE ( MAX ( DimDate[Date] ), FactTrade ) VAR _now = MAX ( DimDate[Date] ) RETURN DATEDIFF ( _last, _now, DAY )
		formatString: #,##0
		displayFolder: 03. Momentum
		lineageTag: 8d757fc8-0a45-4785-8fc1-7c93a7c8a4c6

	/// Distinct items that traded in the trailing 30 days.
	measure 'Items Active 30D' = CALCULATE ( DISTINCTCOUNT ( FactTrade[ItemKey] ), DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ), -30, DAY ) )
		formatString: #,##0
		displayFolder: 03. Momentum
		lineageTag: 3d454b0d-ca73-47bc-ac9f-d950f5e06e9f

	/// Average daily market price across items in context.
	measure 'Avg Market Price' = AVERAGE ( FactMarketPriceDaily[AvgPrice] )
		formatString: "₡"#,##0.00
		displayFolder: 04. Price action
		lineageTag: 36a89b52-d3df-49cd-ae39-95454807c3c9

	/// Volume-weighted average price (the true average buyers paid).
	measure VWAP = DIVIDE ( SUMX ( FactMarketPriceDaily, FactMarketPriceDaily[AvgPrice] * FactMarketPriceDaily[Volume] ), SUM ( FactMarketPriceDaily[Volume] ) )
		formatString: "₡"#,##0.00
		displayFolder: 04. Price action
		lineageTag: 8a1b16fd-8af0-40bf-bf98-4c151681672b

	/// Average daily price range relative to AvgPrice — volatility proxy.
	measure 'Daily Range %' = VAR _h = AVERAGE ( FactMarketPriceDaily[HighPrice] ) VAR _l = AVERAGE ( FactMarketPriceDaily[LowPrice] ) VAR _a = AVERAGE ( FactMarketPriceDaily[AvgPrice] ) RETURN DIVIDE ( _h - _l, _a )
		formatString: 0.0%
		displayFolder: 04. Price action
		lineageTag: ee234835-7254-499b-9a91-3b95e8aafa5d

	/// Highest HighPrice in the trailing 365 days (52-week high).
	measure '52W High' = CALCULATE ( MAX ( FactMarketPriceDaily[HighPrice] ), DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ), -365, DAY ) )
		formatString: "₡"#,##0.00
		displayFolder: 04. Price action
		lineageTag: 8aceb69f-3048-434b-b3ef-2d8dfdf72995

	/// Lowest LowPrice in the trailing 365 days (52-week low).
	measure '52W Low' = CALCULATE ( MIN ( FactMarketPriceDaily[LowPrice] ), DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ), -365, DAY ) )
		formatString: "₡"#,##0.00
		displayFolder: 04. Price action
		lineageTag: 3de5835d-5d6d-4a0f-99fc-a0c5a6d571d2

	/// Distance from 52W High as a negative % (0 = at high; -50% = half the high).
	measure '% from 52W High' = DIVIDE ( [Avg Market Price] - [52W High], [52W High] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04. Price action
		lineageTag: 28161080-fb24-4288-a611-b3632cc6621e

	/// % gain off the 52W Low (recovery indicator).
	measure '% above 52W Low' = DIVIDE ( [Avg Market Price] - [52W Low], [52W Low] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04. Price action
		lineageTag: a493550e-c937-454e-a3bf-5ec75298024b

	/// HEAVY (per-day iteration): max drawdown over the trailing 90 days. Card-only.
	measure 'Max Drawdown 90D %' = VAR _series = ADDCOLUMNS ( DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ), -90, DAY ), "@px", CALCULATE ( AVERAGE ( FactMarketPriceDaily[AvgPrice] ) ) ) VAR _peak = MAXX ( _series, [@px] ) VAR _trough = MINX ( _series, [@px] ) RETURN DIVIDE ( _trough - _peak, _peak )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04. Price action
		lineageTag: c971975d-0b65-4498-aef8-5b90887bb735

	/// Total units listed on the market (daily snapshot sum).
	measure 'Total Market Volume' = SUM ( FactMarketPriceDaily[Volume] )
		formatString: #,##0
		displayFolder: 05. Volume & liquidity
		lineageTag: 549b14ed-dc42-4b16-ac2f-1a20c57b13af

	/// Average daily traded volume.
	measure 'Avg Daily Volume' = DIVIDE ( [Total Market Volume], DISTINCTCOUNT ( FactMarketPriceDaily[DateKey] ) )
		formatString: #,##0
		displayFolder: 05. Volume & liquidity
		lineageTag: cde8ab6c-4f34-4d5a-b017-5dcb7b855b79

	/// Units traded per listing — how fast inventory clears (>1 = strong demand).
	measure 'Turnover Ratio' = DIVIDE ( [Total Market Volume], [Active Listings] )
		formatString: 0.00
		displayFolder: 05. Volume & liquidity
		lineageTag: 169dbbab-5eda-41a3-b4cb-2ab42fc56a60

	/// Estimated days to clear current listings at the current pace.
	measure 'Days to Sell' = DIVIDE ( [Active Listings], [Avg Daily Volume] )
		formatString: #,##0.0
		displayFolder: 05. Volume & liquidity
		lineageTag: b256c34b-1f18-4110-8acd-592620bb4b13

	/// % of tradeable items with zero trades in the trailing 30 days.
	measure 'Dead Stock % 30D' = VAR _tradeable = CALCULATE ( DISTINCTCOUNT ( DimItem[ItemKey] ), DimItem[IsTradeable] = TRUE ) VAR _active = CALCULATE ( DISTINCTCOUNT ( FactTrade[ItemKey] ), DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ), -30, DAY ), DimItem[IsTradeable] = TRUE ) RETURN DIVIDE ( _tradeable - _active, _tradeable )
		formatString: 0.0%
		displayFolder: 05. Volume & liquidity
		lineageTag: e34f57a9-5497-47c1-83f1-16513383ab81

	/// Items with turnover ratio above 1 (strong liquidity).
	measure 'Liquid Items Count' = CALCULATE ( DISTINCTCOUNT ( FactMarketPriceDaily[ItemKey] ), FILTER ( VALUES ( DimItem[ItemKey] ), [Turnover Ratio] > 1 ) )
		formatString: #,##0
		displayFolder: 05. Volume & liquidity
		lineageTag: 51c3fd17-bb90-4aaf-bfba-b504359f1abd

	/// Share of total trade value captured by the item in context.
	measure 'Item % of Trade Value' = DIVIDE ( [Total Trade Value], CALCULATE ( [Total Trade Value], ALLSELECTED ( DimItem[ItemName] ) ) )
		formatString: 0.00%
		displayFolder: 06. Concentration & Pareto
		lineageTag: 3ea7fa6e-8bc5-4c9f-ac35-dadfe111de3a

	/// Pareto cumulative — running share of total when items are sorted descending by trade value (sort-independent).
	measure 'Cumulative % Trade Value' = VAR _cur = [Total Trade Value] VAR _grand = CALCULATE ( [Total Trade Value], ALLSELECTED ( DimItem[ItemName] ) ) VAR _cum = CALCULATE ( [Total Trade Value], FILTER ( ALLSELECTED ( DimItem[ItemName] ), CALCULATE ( [Total Trade Value] ) >= _cur ) ) RETURN DIVIDE ( _cum, _grand )
		formatString: 0.0%
		displayFolder: 06. Concentration & Pareto
		lineageTag: 302a82c9-f612-46db-bef5-3e84104ab0a4

	/// Number of items that make up the first 80% of trade value (Pareto count).
	measure '# Items to 80%' = COUNTROWS ( FILTER ( VALUES ( DimItem[ItemName] ), [Cumulative % Trade Value] <= 0.8 ) ) + 1
		formatString: #,##0
		displayFolder: 06. Concentration & Pareto
		lineageTag: 872c04ab-49a6-4dc8-b7ed-24a972dfa808

	/// Share of total trade value captured by the top 10 items.
	measure 'Top 10 Trade Concentration %' = VAR _all = CALCULATE ( [Total Trade Value], ALLSELECTED ( DimItem ) ) VAR _top10 = CALCULATE ( [Total Trade Value], TOPN ( 10, ALLSELECTED ( DimItem[ItemKey] ), [Total Trade Value], DESC ) ) RETURN DIVIDE ( _top10, _all )
		formatString: 0.0%
		displayFolder: 06. Concentration & Pareto
		lineageTag: 75fd7774-a2e2-4b05-8f4d-c4a5daede147

	/// Herfindahl-Hirschman Index of trade value across items (0-10000). >2500 = highly concentrated market.
	measure 'HHI Items' = VAR _grand = CALCULATE ( [Total Trade Value], ALLSELECTED ( DimItem ) ) VAR _shares = ADDCOLUMNS ( VALUES ( DimItem[ItemKey] ), "@share", DIVIDE ( [Total Trade Value], _grand ) ) RETURN SUMX ( _shares, [@share] * [@share] * 10000 )
		formatString: #,##0
		displayFolder: 06. Concentration & Pareto
		lineageTag: e6042ecb-be53-4855-a0f4-4dc562e0a373

	/// Distinct sellers in context.
	measure 'Distinct Sellers' = DISTINCTCOUNT ( FactTrade[SellerKey] )
		formatString: #,##0
		displayFolder: 07. Sellers
		lineageTag: 71254c1f-879b-46b7-8b5e-eabe299d5391

	/// Trade quantity from NPC sellers.
	measure 'NPC Volume' = CALCULATE ( [Trade Quantity], DimSeller[SellerType] = "NPC" )
		formatString: #,##0
		displayFolder: 07. Sellers
		lineageTag: cbf5336c-1220-44e1-b060-58c42519a30b

	/// Share of trade value flowing through NPC vendors.
	measure 'NPC Trade Share %' = DIVIDE ( CALCULATE ( [Total Trade Value], DimSeller[SellerType] = "NPC" ), [Total Trade Value] )
		formatString: 0.0%
		displayFolder: 07. Sellers
		lineageTag: f74a0d82-c094-4223-a0e5-413b931270e2

	/// Trade quantity from Player sellers (the real market).
	measure 'Player Volume' = CALCULATE ( [Trade Quantity], DimSeller[SellerType] = "Player" )
		formatString: #,##0
		displayFolder: 07. Sellers
		lineageTag: abd04eb6-baed-4347-9c83-e762168a605b

	/// Avg trades per active seller.
	measure 'Avg Trades per Seller' = DIVIDE ( [Trade Count], [Distinct Sellers] )
		formatString: #,##0
		displayFolder: 07. Sellers
		lineageTag: cd9e8759-f4e6-4ab6-ac2a-6126408331ad

	/// HHI of seller concentration (0-10000). >2500 = monopolistic capture; <1500 = competitive.
	measure 'HHI Sellers' = VAR _grand = [Total Trade Value] VAR _shares = ADDCOLUMNS ( VALUES ( DimSeller[SellerKey] ), "@share", DIVIDE ( CALCULATE ( [Total Trade Value] ), _grand ) ) RETURN SUMX ( _shares, [@share] * [@share] * 10000 )
		formatString: #,##0
		displayFolder: 07. Sellers
		lineageTag: 88834f2f-5187-4c5a-8879-5a85bde19a04

	/// Trade value attributable to Mythic-rarity items.
	measure 'Mythic Trade Value' = CALCULATE ( [Total Trade Value], DimRarity[RarityName] = "Mythic" )
		formatString: "₡"#,##0
		displayFolder: 08. Rarity
		lineageTag: e937c8da-fc45-4420-bca5-479e08578c90

	/// Share of trade value captured by Mythic items — the high-end signal.
	measure 'Mythic Trade Share %' = DIVIDE ( [Mythic Trade Value], [Total Trade Value] )
		formatString: 0.00%
		displayFolder: 08. Rarity
		lineageTag: a8a95a73-4e00-461d-a41c-d80734cabf7f

	/// Share of trade value captured by Common-rarity items.
	measure 'Common Trade Share %' = DIVIDE ( CALCULATE ( [Total Trade Value], DimRarity[RarityName] = "Common" ), [Total Trade Value] )
		formatString: 0.0%
		displayFolder: 08. Rarity
		lineageTag: c81515b7-4bf3-4031-b4c8-68167610bb82

	/// Share of trade value captured by Rare and above (RarityRank >= 3) — the premium market.
	measure 'Rare+ Trade Share %' = DIVIDE ( CALCULATE ( [Total Trade Value], DimRarity[RarityRank] >= 3 ), [Total Trade Value] )
		formatString: 0.0%
		displayFolder: 08. Rarity
		lineageTag: 7a74ead4-4897-4362-8768-a13b8bd8a76d

	/// Price multiplier vs Common baseline (current avg price / common avg price).
	measure 'Rarity Premium x Common' = VAR _self = [Avg Market Price] VAR _common = CALCULATE ( [Avg Market Price], ALL ( DimRarity ), DimRarity[RarityName] = "Common" ) RETURN DIVIDE ( _self, _common )
		formatString: 0.0"x"
		displayFolder: 08. Rarity
		lineageTag: 0fffb485-8d46-4aab-b0cf-ba0dbbeb1771

	/// Count of distinct items at the rarity tier in context.
	measure 'Items at Rarity' = CALCULATE ( DISTINCTCOUNT ( DimItem[ItemKey] ), DimItem[IsTradeable] = TRUE )
		formatString: #,##0
		displayFolder: 08. Rarity
		lineageTag: 03fd39b2-91f6-4c80-ba22-41837113ed0e

	/// 1-level craft cost: sum of (ingredient AvgPrice × QtyRequired) / YieldQty. One level only — recursive BOM deferred.
	measure '1-Level Craft Cost' = VAR _itemKey = SELECTEDVALUE ( DimItem[ItemKey] ) VAR _recipeKey = CALCULATE ( MAX ( DimRecipe[RecipeKey] ), DimRecipe[OutputItemKey] = _itemKey ) VAR _yield = LOOKUPVALUE ( DimRecipe[YieldQty], DimRecipe[RecipeKey], _recipeKey ) VAR _ingredients = FILTER ( ALL ( FactRecipeIngredient ), FactRecipeIngredient[RecipeKey] = _recipeKey ) VAR _cost = SUMX ( _ingredients, VAR _ingKey = FactRecipeIngredient[IngredientItemKey] VAR _ingPrice = CALCULATE ( AVERAGE ( FactMarketPriceDaily[AvgPrice] ), ALL ( DimItem ), DimItem[ItemKey] = _ingKey ) RETURN _ingPrice * FactRecipeIngredient[QtyRequired] ) RETURN DIVIDE ( _cost, _yield )
		formatString: "₡"#,##0.00
		displayFolder: 09. Craft vs Buy
		lineageTag: b237ae6d-f62f-49f9-b19e-d41184d27a6b

	/// Market price minus craft cost. Positive = market values it above craft cost (craft to sell).
	measure 'Craft Margin' = [Avg Market Price] - [1-Level Craft Cost]
		formatString: "₡"#,##0.00
		displayFolder: 09. Craft vs Buy
		lineageTag: b03ba658-ab28-4140-b6a0-65e99e3857c4

	/// Craft margin as % of craft cost. >10% = craft to resell; <-10% = buy from market.
	measure 'Craft Margin %' = DIVIDE ( [Craft Margin], [1-Level Craft Cost] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 09. Craft vs Buy
		lineageTag: d0da9b5a-4297-43ec-a2f4-219da60026fe

	/// CRAFT / BUY / NEUTRAL verdict — drives a card or conditional fill.
	measure 'Craft Verdict' = VAR _m = [Craft Margin %] RETURN SWITCH ( TRUE (), ISBLANK ( [1-Level Craft Cost] ), "— not craftable", _m > 0.10, "CRAFT (resell)", _m < -0.10, "BUY (market cheaper)", "NEUTRAL" )
		displayFolder: 09. Craft vs Buy
		lineageTag: 43039717-390b-455e-b1e2-50b0ee166445

	/// Hex color for the verdict — wire to dataPoint.fill or background.
	measure 'Craft Verdict Color' = VAR _m = [Craft Margin %] RETURN SWITCH ( TRUE (), ISBLANK ( [1-Level Craft Cost] ), "#888888", _m > 0.10, "#2D6948", _m < -0.10, "#A23A2A", "#9A9A9A" )
		displayFolder: 09. Craft vs Buy
		lineageTag: d125b187-0436-4f7f-8131-9c55e477e5f6

	/// Count of items where crafting is profitable (margin > +10%).
	measure '# Profitable to Craft' = CALCULATE ( DISTINCTCOUNT ( DimItem[ItemKey] ), FILTER ( VALUES ( DimItem[ItemKey] ), [Craft Margin %] > 0.10 ) )
		formatString: #,##0
		displayFolder: 09. Craft vs Buy
		lineageTag: 3d2ad987-4458-4042-9724-1e456dd6b2de

	/// Distinct monsters that drop the items in context.
	measure '# Drop Sources' = DISTINCTCOUNT ( FactDropTable[MonsterKey] )
		formatString: #,##0
		displayFolder: 10. Acquisition
		lineageTag: f66b0e03-67ca-435b-890b-d128279d4bc9

	/// Average drop rate % across the drop combos in context.
	measure 'Avg Drop Rate %' = DIVIDE ( AVERAGE ( FactDropTable[DropRatePct] ), 100 )
		formatString: 0.00%
		displayFolder: 10. Acquisition
		lineageTag: 31afaac2-7bbf-4d6e-8529-d518a6acd824

	/// Share of items that are craftable.
	measure '% Craftable Items' = DIVIDE ( CALCULATE ( DISTINCTCOUNT ( DimItem[ItemKey] ), DimItem[IsCraftable] = TRUE ), DISTINCTCOUNT ( DimItem[ItemKey] ) )
		formatString: 0.0%
		displayFolder: 10. Acquisition
		lineageTag: 6515e6c4-a844-4067-af15-028446063a01

	/// Recipes in context (output item count).
	measure '# Recipes' = DISTINCTCOUNT ( DimRecipe[RecipeKey] )
		formatString: #,##0
		displayFolder: 10. Acquisition
		lineageTag: 71c037ef-2209-402b-be88-a44fc1b1374d

	/// Average craft time in seconds.
	measure 'Avg Craft Time (s)' = AVERAGE ( DimRecipe[CraftTimeSecs] )
		formatString: #,##0
		displayFolder: 10. Acquisition
		lineageTag: f429db8a-2f64-4e8f-9d47-a8d1465fc5f6

	/// Distinct events overlapping the date range in context.
	measure 'Events In Period' = CALCULATE ( DISTINCTCOUNT ( DimMarketEvent[EventKey] ), FILTER ( ALL ( DimMarketEvent ), DimMarketEvent[StartDate] <= MAX ( DimDate[Date] ) && DimMarketEvent[EndDate] >= MIN ( DimDate[Date] ) ) )
		formatString: #,##0
		displayFolder: 11. Events
		lineageTag: 806570e2-4998-4588-b38e-6c3fd8f40e60

	/// Average price-shock magnitude across overlapping events.
	measure 'Avg Event Shock %' = CALCULATE ( AVERAGE ( DimMarketEvent[PriceShockPct] ), FILTER ( ALL ( DimMarketEvent ), DimMarketEvent[StartDate] <= MAX ( DimDate[Date] ) && DimMarketEvent[EndDate] >= MIN ( DimDate[Date] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 11. Events
		lineageTag: 4dd36aa5-a50f-4746-b3fb-8ceedb7ae122

	/// Days within the period that are inside ANY event window.
	measure 'Event Days' = COUNTROWS ( FILTER ( DimDate, COUNTROWS ( FILTER ( ALL ( DimMarketEvent ), DimMarketEvent[StartDate] <= DimDate[Date] && DimMarketEvent[EndDate] >= DimDate[Date] ) ) > 0 ) )
		formatString: #,##0
		displayFolder: 11. Events
		lineageTag: bd7f1e00-bf04-4c44-9cee-6c46a3801f8c

	/// Total trade value on days that fall inside any event window.
	measure 'Trade Value During Events' = VAR _eventDays = FILTER ( DimDate, COUNTROWS ( FILTER ( ALL ( DimMarketEvent ), DimMarketEvent[StartDate] <= DimDate[Date] && DimMarketEvent[EndDate] >= DimDate[Date] ) ) > 0 ) RETURN CALCULATE ( [Total Trade Value], _eventDays )
		formatString: "₡"#,##0
		displayFolder: 11. Events
		lineageTag: 19960773-05d5-473d-a3da-64ece24b15e0

	/// Items that haven't traded in the trailing 30 days (dead-stock list count).
	measure 'Items No Volume 30D' = VAR _tradeable = CALCULATE ( DISTINCTCOUNT ( DimItem[ItemKey] ), DimItem[IsTradeable] = TRUE ) VAR _active = CALCULATE ( DISTINCTCOUNT ( FactTrade[ItemKey] ), DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ), -30, DAY ), DimItem[IsTradeable] = TRUE ) RETURN _tradeable - _active
		formatString: #,##0
		displayFolder: 12. Quality
		lineageTag: c3d06725-0138-4559-b4c2-cdde45f4d1bd

	/// OHLC integrity check: rows where Low > Open/Close or High < Open/Close (should be 0).
	measure 'OHLC Integrity Errors' = COUNTROWS ( FILTER ( FactMarketPriceDaily, FactMarketPriceDaily[LowPrice] > FactMarketPriceDaily[OpenPrice] || FactMarketPriceDaily[LowPrice] > FactMarketPriceDaily[ClosePrice] || FactMarketPriceDaily[HighPrice] < FactMarketPriceDaily[OpenPrice] || FactMarketPriceDaily[HighPrice] < FactMarketPriceDaily[ClosePrice] ) )
		formatString: #,##0
		displayFolder: 12. Quality
		lineageTag: d7432b53-6add-432d-82e8-492d687569ea

	/// Items where AvgPrice spikes more than 3x the trailing 90D average — anomaly count.
	measure 'Items With Spike 3x' = CALCULATE ( DISTINCTCOUNT ( DimItem[ItemKey] ), FILTER ( VALUES ( DimItem[ItemKey] ), VAR _now = [Avg Market Price] VAR _trail = CALCULATE ( AVERAGE ( FactMarketPriceDaily[AvgPrice] ), DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ) - 1, -90, DAY ) ) RETURN _now > 3 * _trail ) )
		formatString: #,##0
		displayFolder: 12. Quality
		lineageTag: 0eb4be57-d080-4272-b831-5b08b561c91c

	/// Total items in the model (sanity check on DimItem).
	measure 'Total Items' = DISTINCTCOUNT ( DimItem[ItemKey] )
		formatString: #,##0
		displayFolder: 12. Quality
		lineageTag: dbcf260e-9884-4a5c-b329-dffaf2359d55

	/// Opening price (sum; meaningful when filtered to one item via the Item slicer).
	measure Open = SUM ( FactMarketPriceDaily[OpenPrice] )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: 317a4f31-a679-4654-9394-33682e8988ef

	/// Closing price.
	measure Close = SUM ( FactMarketPriceDaily[ClosePrice] )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: 030a2d04-45fc-4fbc-8531-ea2e53110f96

	/// Highest price of the day.
	measure High = SUM ( FactMarketPriceDaily[HighPrice] )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: 45e76e0e-6f2c-4d19-ba19-c8591d5ccb09

	/// Lowest price of the day.
	measure Low = SUM ( FactMarketPriceDaily[LowPrice] )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: e4b3d0b5-3c47-4002-ac2f-36f0b5ef5046

	/// Boolean flag (0/1) for green vs red candle.
	measure 'Is Up Day' = IF ( [Close] >= [Open], 1, 0 )
		formatString: 0
		displayFolder: 13. OHLC Candlestick
		lineageTag: bbc85c9d-3fd8-4883-b7f1-5eddf248ad94

	/// Transparent floater — lifts the visible body to MIN(Open, Close).
	measure 'Body Floor' = IF ( [Is Up Day] = 1, [Open], [Close] )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: 2a1798eb-19cd-48e3-b0a0-261219454af0

	/// Height of the visible candle body = |Close - Open|.
	measure 'Body Height' = ABS ( [Close] - [Open] )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: 94d9b285-561e-468f-97bb-d3d9469a6043

	/// Body height — fires only on up days. Gets its own green error bar for the wick.
	measure 'Body Height Up' = IF ( [Is Up Day] = 1, [Body Height] )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: b6dd2a3f-583b-461f-90ad-7f01def4ff84

	/// Body height — fires only on down days. Gets its own red error bar for the wick.
	measure 'Body Height Down' = IF ( [Is Up Day] = 0, [Body Height] )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: ae6ca64c-656a-4671-b0cf-444cdd7033e0

	/// Upper wick bound (absolute Y) — fires only on up days. Bound to a green error bar.
	measure 'Wick Up Hi' = IF ( [Is Up Day] = 1, [High] )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: 238934ba-1c49-496e-80f4-634e7955d141

	/// Lower wick bound (absolute Y) — fires only on up days. Bound to the green error bar.
	measure 'Wick Up Lo' = IF ( [Is Up Day] = 1, [Low] )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: e2197631-4a31-455c-abb5-9709cc5b6c88

	/// Upper wick bound (absolute Y) — fires only on down days. Bound to a red error bar.
	measure 'Wick Down Hi' = IF ( [Is Up Day] = 0, [High] )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: 3d2c2b2f-6cdf-4308-855b-59080691c131

	/// Lower wick bound (absolute Y) — fires only on down days. Bound to the red error bar.
	measure 'Wick Down Lo' = IF ( [Is Up Day] = 0, [Low] )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: 5fe12a36-69ea-4f8a-94e5-3f1bdcc94236

	/// Hex color per day for body + volume conditional fill (green up, red down).
	measure 'Candle Color' = IF ( [Is Up Day] = 1, "#2D6948", "#A23A2A" )
		displayFolder: 13. OHLC Candlestick
		lineageTag: e5961abc-0e7d-4b24-8f11-600c0d42e05a

	/// Day return (Close - Open) / Open.
	measure 'Day Change %' = DIVIDE ( [Close] - [Open], [Open] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 13. OHLC Candlestick
		lineageTag: e5928e19-7908-462c-96c6-dbb1052124d9

	/// Selected item name (or 'Multiple items' if more than one). Use for dynamic card titles.
	measure 'Item Display Name' = VAR _n = SELECTEDVALUE ( DimItem[ItemName] ) RETURN IF ( ISBLANK ( _n ), "Multiple items", _n )
		displayFolder: 13. OHLC Candlestick
		lineageTag: 135d6c80-9807-4a82-b893-04a5ec51f2b6

	/// Close from the previous day (for daily % change vs last close).
	measure 'Prior Close' = VAR _prior = MAX ( DimDate[Date] ) - 1 RETURN CALCULATE ( [Close], DimDate[Date] = _prior )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: d18ba107-f646-4ee3-8254-ac669d577239

	/// Close vs prior close (the KPI tile's headline % change).
	measure 'Close vs Prior %' = DIVIDE ( [Close] - [Prior Close], [Prior Close] )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 13. OHLC Candlestick
		lineageTag: 4e4afb2e-1176-4be4-8ff1-994924023043

	/// 3-month price change %.
	measure 'Close vs 3M %' = VAR _t = MAX ( DimDate[Date] ) VAR _then = CALCULATE ( [Close], DimDate[Date] = _t - 90 ) RETURN DIVIDE ( [Close] - _then, _then )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 13. OHLC Candlestick
		lineageTag: 7b1d96bb-d3aa-49c0-813c-3f0f2b5fb7de

	/// 3-month price change in gold.
	measure 'Close vs 3M $' = VAR _t = MAX ( DimDate[Date] ) VAR _then = CALCULATE ( [Close], DimDate[Date] = _t - 90 ) RETURN [Close] - _then
		formatString: +"₡"#,##0.00;-"₡"#,##0.00;"₡"0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: 4096c5b3-658c-44a4-b00c-f46ef97164f7

	/// Card footer label (mimics 'As of close: 12 January 2023 · USD · NASDAQ').
	measure 'As Of Label' = VAR _d = MAX ( DimDate[Date] ) RETURN "As of close: " & FORMAT ( _d, "d mmmm yyyy" ) & " · gp · Grand Exchange"
		displayFolder: 13. OHLC Candlestick
		lineageTag: d17a174e-c26f-4e07-a928-c34a9083bb2a

	/// Harvester — days-back from the picked Range tile. Default 90 (3M) when nothing is picked.
	measure 'Selected Days Back' = SELECTEDVALUE ( Range[DaysBack], 90 )
		formatString: 0
		displayFolder: 13. OHLC Candlestick
		lineageTag: af07354e-af38-4428-9fe8-888de62e1201

	/// Visual-level filter: 1 if the date is inside the picked Range window (e.g. last 90 days, or YTD). Wire to candle + volume charts as filter = 1.
	measure 'Date In Range' = VAR _today = CALCULATE ( MAX ( DimDate[Date] ), ALL ( DimDate ) ) VAR _days = [Selected Days Back] VAR _start = IF ( _days = -1, DATE ( YEAR ( _today ), 1, 1 ), _today - _days ) VAR _here = MAX ( DimDate[Date] ) RETURN IF ( _here >= _start && _here <= _today, 1, 0 )
		formatString: 0
		displayFolder: 13. OHLC Candlestick
		lineageTag: 2a2a6847-db0e-4c4d-a2e6-2993df301781

	/// Upper wick distance (Tomas formula). Negative → PBI error-bar engine draws UP from body top by |this|. RELATIVE bound.
	measure 'High Distance' = VAR _diff = MAXX ( FactMarketPriceDaily, FactMarketPriceDaily[ClosePrice] - FactMarketPriceDaily[OpenPrice] ) VAR _maxOC = IF ( _diff > 0, MAXX ( FactMarketPriceDaily, FactMarketPriceDaily[ClosePrice] ), MAXX ( FactMarketPriceDaily, FactMarketPriceDaily[OpenPrice] ) ) VAR _high = MAXX ( FactMarketPriceDaily, FactMarketPriceDaily[HighPrice] ) RETURN ABS ( _high - _maxOC ) * -1
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: 63ef980b-1795-455d-aae9-c6de7b1e5247

	/// Lower wick distance (Tomas formula). Positive → draws DOWN from body bottom by this amount. RELATIVE bound.
	measure 'Low Distance' = VAR _diff = MAXX ( FactMarketPriceDaily, FactMarketPriceDaily[ClosePrice] - FactMarketPriceDaily[OpenPrice] ) VAR _minOC = IF ( _diff < 0, MAXX ( FactMarketPriceDaily, FactMarketPriceDaily[ClosePrice] ), MAXX ( FactMarketPriceDaily, FactMarketPriceDaily[OpenPrice] ) ) VAR _low = MAXX ( FactMarketPriceDaily, FactMarketPriceDaily[LowPrice] ) RETURN ABS ( _low - _minOC )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: a30983da-3dcd-41fc-ae96-3b7751fb3ef9

	/// 1 when today's Close >= yesterday's Close (real market direction). Drives Green/Red Volume split.
	measure 'Up vs Prior Close' = VAR _curr = MAXX ( FactMarketPriceDaily, FactMarketPriceDaily[ClosePrice] ) VAR _prior = CALCULATE ( MAXX ( FactMarketPriceDaily, FactMarketPriceDaily[ClosePrice] ), DATEADD ( DimDate[Date], -1, DAY ) ) RETURN IF ( _curr >= _prior, 1, 0 )
		formatString: 0
		displayFolder: 13. OHLC Candlestick
		lineageTag: 144bad9f-d3cb-4c08-a8a4-c8031cf2d828

	/// Volume when Close >= Prior Close — plotted as green column.
	measure 'Green Volume' = IF ( [Up vs Prior Close] = 1, SUM ( FactMarketPriceDaily[Volume] ) )
		formatString: #,##0
		displayFolder: 13. OHLC Candlestick
		lineageTag: 285d8035-49c2-4080-981f-3f97a87c9e66

	/// Volume when Close < Prior Close — plotted as red column.
	measure 'Red Volume' = IF ( [Up vs Prior Close] = 0, SUM ( FactMarketPriceDaily[Volume] ) )
		formatString: #,##0
		displayFolder: 13. OHLC Candlestick
		lineageTag: 4b9cff62-49c8-4e57-8696-998eb2b73782

	/// Dynamic moving average of Close — picks period from tParameter slicer (default 20).
	measure 'Moving Average' = VAR _period = SELECTEDVALUE ( 'tParameter'[Value], 20 ) VAR _num = CALCULATE ( SUM ( FactMarketPriceDaily[ClosePrice] ), DATESINPERIOD ( DimDate[Date], LASTDATE ( DimDate[Date] ), -_period, DAY ) ) VAR _den = CALCULATE ( COUNT ( DimDate[Date] ), DATESINPERIOD ( DimDate[Date], LASTDATE ( DimDate[Date] ), -_period, DAY ) ) RETURN DIVIDE ( _num, _den )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: dc295971-63d9-47da-9126-a52118d9ba1e

	/// Y axis upper pin (Close max + 5) — Tomas's MaxY.
	measure MaxY = MAX ( FactMarketPriceDaily[ClosePrice] ) + 5
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: f39ae8a6-995a-482b-84f5-fb7d2f381bce

	/// Y axis lower pin (Close min - 5) — Tomas's MinY.
	measure MinY = MIN ( FactMarketPriceDaily[ClosePrice] ) - 5
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: f21b9837-c712-4c7d-a458-9e9383d14a65

	/// Y axis upper pin for volume chart.
	measure MaxVolume = MAX ( FactMarketPriceDaily[Volume] )
		formatString: #,##0
		displayFolder: 13. OHLC Candlestick
		lineageTag: eab95d49-5bff-4327-bae7-46301e7303cf

	/// Close price on the most recent date in the current selection.
	measure 'Last Close Price' = VAR _last = CALCULATE ( MAX ( DimDate[Date] ), ALLSELECTED ( FactMarketPriceDaily ) ) RETURN CALCULATE ( AVERAGE ( FactMarketPriceDaily[ClosePrice] ), DimDate[Date] = _last )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: 14aa9341-6373-4540-ade1-a8348f8ec2a6

	/// Card footer (Tomas's 'At Close' equivalent).
	measure 'At Close Label' = VAR _d = MAX ( DimDate[Date] ) RETURN "At close: " & FORMAT ( _d, "d mmmm yyyy" ) & " · gp · Grand Exchange"
		displayFolder: 13. OHLC Candlestick
		lineageTag: 644f494c-c20a-4a44-a805-7f4cbb251931

	/// Current Close vs previous trading-day Close (Tomas pattern, column-based via VarCurrPrev).
	measure 'Variation Curr Vs Prec' =
			VAR _PrevClose = AVERAGE(FactMarketPriceDaily[VarCurrPrev])
			VAR _CurrClose = AVERAGE(FactMarketPriceDaily[ClosePrice])
			RETURN
			DIVIDE(_CurrClose, _PrevClose) - 1
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 13. OHLC Candlestick
		lineageTag: 260b1652-31f0-4aba-84ef-bf66354edbe6

	/// Close price on the StartDate of the picked dimPeriod — the baseline for Variation %.
	measure 'Beginning Period Price' = VAR _price = CALCULATE ( MAX ( FactMarketPriceDaily[ClosePrice] ), DimDate[Date] = MAX ( dimPeriod[StartDate] ) ) VAR _ajusted = CALCULATE ( MAX ( FactMarketPriceDaily[ClosePrice] ), DimDate[Date] = MAX ( dimPeriod[StartDate] ) + 1 ) RETURN IF ( ISBLANK ( _price ), _ajusted, _price )
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: 09251b0a-49d7-4e66-a6f4-4f4994d859e7

	/// Visual-level filter: 1 when DimDate[Date] >= dimPeriod[StartDate]. Defaults to 3M window when no Range slicer selection.
	measure 'Date Filter' = VAR _hasSel = HASONEVALUE ( dimPeriod[Period] ) VAR _start = IF ( _hasSel, MAX ( dimPeriod[StartDate] ), CALCULATE ( MAX ( dimPeriod[StartDate] ), dimPeriod[Period] = "3M" ) ) RETURN IF ( MAX ( DimDate[Date] ) >= _start, 1 )
		formatString: 0
		displayFolder: 13. OHLC Candlestick
		lineageTag: 16284612-37dc-476e-a09b-dc142d3cb164

	/// Arrow + delta + period label (e.g. '▲ 9.95 3M') — Tomas's Variation # for the KPI tile.
	measure 'Variation #' = VAR _delta = [Last Close Price] - [Beginning Period Price] VAR _period = MAX ( dimPeriod[Period] ) VAR _arrow = IF ( _delta > 0, UNICHAR ( 129033 ), UNICHAR ( 129035 ) ) & " " RETURN _arrow & FORMAT ( ABS ( _delta ), "0.00" ) & "  " & _period
		displayFolder: 13. OHLC Candlestick
		lineageTag: d8b172b1-f531-4dda-84f7-93d480cacf62

	/// Arrow + percent change vs Beginning Period Price (e.g. '▲ 4.35%').
	measure 'Variation %' = VAR _v = DIVIDE ( [Last Close Price], [Beginning Period Price] ) - 1 VAR _arrow = IF ( _v > 0, UNICHAR ( 129033 ), UNICHAR ( 129035 ) ) & " " RETURN _arrow & FORMAT ( ABS ( _v ), "0.00%" )
		displayFolder: 13. OHLC Candlestick
		lineageTag: c7aa8b71-fc02-417d-bf77-3f35264e0f7a

	/// 1 = green, 0 = red — drives conditional card background for the Variation tile.
	measure 'Variation Indicator' = VAR _v = DIVIDE ( [Last Close Price], [Beginning Period Price] ) - 1 RETURN IF ( _v >= 0, 1, 0 )
		formatString: 0
		displayFolder: 13. OHLC Candlestick
		lineageTag: 0d39b5c5-fd48-4e49-bff3-308a86c0ed98

	/// Composite monospaced tooltip body — Date header + OHLCV + % Change. Bind to a tooltip page (Consolas font).
	measure ToolTips =
			VAR _Date = FORMAT(MAX(DimDate[Date]), "d MMMM yyyy", "en-CA")
			VAR _OpenText = "Open"
			VAR _HighText = "High"
			VAR _LowText = "Low"
			VAR _CloseText = "Close"
			VAR _VolumeText = "Volume"
			VAR _PercChangeText = "% Change"
			VAR _Open   = FORMAT(MAX(FactMarketPriceDaily[OpenPrice]),  "#,##0.00")
			VAR _High   = FORMAT(MAX(FactMarketPriceDaily[HighPrice]),  "#,##0.00")
			VAR _Low    = FORMAT(MAX(FactMarketPriceDaily[LowPrice]),   "#,##0.00")
			VAR _Close  = FORMAT(MAX(FactMarketPriceDaily[ClosePrice]), "#,##0.00")
			VAR _Volume = FORMAT(MAX(FactMarketPriceDaily[Volume]),     "#,##0")
			VAR _Variation = FORMAT([Variation Curr Vs Prec], "+0.00%;-0.00%;0.00%")
			VAR _Espace = UNICHAR(8206) & " "
			VAR _BeforeEspaceNumber = 15
			VAR _Lenght = 12
			VAR _TotalLenght = _BeforeEspaceNumber + _Lenght
			VAR _LenghtOfDashLine = REPT("-", _TotalLenght)
			VAR _CenteredText = ROUND(DIVIDE(_TotalLenght - LEN(_Date), 2), 0)
			RETURN
			_LenghtOfDashLine & UNICHAR(10) &
			REPT(_Espace, _CenteredText) & _Date & UNICHAR(10) &
			_LenghtOfDashLine & UNICHAR(10) &
			_OpenText       & REPT(_Espace, _BeforeEspaceNumber - LEN(_OpenText))       & REPT(_Espace, _Lenght - LEN(_Open))      & _Open      & UNICHAR(10) &
			_HighText       & REPT(_Espace, _BeforeEspaceNumber - LEN(_HighText))       & REPT(_Espace, _Lenght - LEN(_High))      & _High      & UNICHAR(10) &
			_LowText        & REPT(_Espace, _BeforeEspaceNumber - LEN(_LowText))        & REPT(_Espace, _Lenght - LEN(_Low))       & _Low       & UNICHAR(10) &
			_CloseText      & REPT(_Espace, _BeforeEspaceNumber - LEN(_CloseText))      & REPT(_Espace, _Lenght - LEN(_Close))     & _Close     & UNICHAR(10) &
			_VolumeText     & REPT(_Espace, _BeforeEspaceNumber - LEN(_VolumeText))     & REPT(_Espace, _Lenght - LEN(_Volume))    & _Volume    & UNICHAR(10) &
			_PercChangeText & REPT(_Espace, _BeforeEspaceNumber - LEN(_PercChangeText)) & REPT(_Espace, _Lenght - LEN(_Variation)) & _Variation
		displayFolder: 13. OHLC Candlestick
		lineageTag: dd7b9038-0332-43c2-839d-42fab72720e4

	/// Highest HighPrice ever recorded for the selected item, ignoring DimDate slicer + dimPeriod tile. Static anchor.
	measure 'All-Time High' =
			CALCULATE(
			    MAX(FactMarketPriceDaily[HighPrice]),
			    REMOVEFILTERS(DimDate),
			    REMOVEFILTERS(dimPeriod)
			)
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: 655549fb-56ff-4980-8700-f6e0e827730c

	/// Lowest LowPrice ever recorded for the selected item, ignoring DimDate slicer + dimPeriod tile. Static anchor.
	measure 'All-Time Low' =
			CALCULATE(
			    MIN(FactMarketPriceDaily[LowPrice]),
			    REMOVEFILTERS(DimDate),
			    REMOVEFILTERS(dimPeriod)
			)
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: fa251248-f7fa-4b4c-b14b-d8d0531ed0b5

	/// Highest HighPrice within the currently selected date range. Respects dimPeriod tile (defaults to 3M when none selected) and the DimDate slicer.
	measure 'Period High' =
			VAR _hasSel = HASONEVALUE(dimPeriod[Period])
			VAR _start = IF(
			    _hasSel,
			    MAX(dimPeriod[StartDate]),
			    CALCULATE(MAX(dimPeriod[StartDate]), dimPeriod[Period] = "3M")
			)
			RETURN
			CALCULATE(
			    MAX(FactMarketPriceDaily[HighPrice]),
			    DimDate[Date] >= _start
			)
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: dc50c572-5fee-4870-aec1-f9eaf2d44531

	/// Lowest LowPrice within the currently selected date range. Respects dimPeriod tile (defaults to 3M when none selected) and the DimDate slicer.
	measure 'Period Low' =
			VAR _hasSel = HASONEVALUE(dimPeriod[Period])
			VAR _start = IF(
			    _hasSel,
			    MAX(dimPeriod[StartDate]),
			    CALCULATE(MAX(dimPeriod[StartDate]), dimPeriod[Period] = "3M")
			)
			RETURN
			CALCULATE(
			    MIN(FactMarketPriceDaily[LowPrice]),
			    DimDate[Date] >= _start
			)
		formatString: "₡"#,##0.00
		displayFolder: 13. OHLC Candlestick
		lineageTag: e706577a-723f-40fc-84db-1e8bd4e7306e

	/// 6 ornate gold frames stacked on transparent bg (240×720). No text. Wallpaper measure renders behind.
