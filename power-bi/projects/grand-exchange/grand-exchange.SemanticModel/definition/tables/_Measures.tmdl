		lineageTag: a4231fd7-ad45-4f3f-b6e4-0755088d6e18
		dataCategory: ImageUrl

	/// Gold value traded on the latest day in selection (last session turnover).
	measure 'Daily Turnover' = CALCULATE ( [Total Trade Value], LASTDATE ( DimDate[Date] ) )
		formatString: "₡"#,##0
		displayFolder: 01. Headline
		lineageTag: aa6e5bc9-46a4-48e6-8141-f103bca9963b

	/// Daily turnover change vs the previous day.
	measure 'Turnover vs Prior Day %' =
			VAR _cur = [Daily Turnover]
			VAR _prev = CALCULATE ( [Total Trade Value], DATEADD ( LASTDATE ( DimDate[Date] ), -1, DAY ) )
			RETURN DIVIDE ( _cur - _prev, _prev )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01. Headline
		lineageTag: e15b9f8f-73bb-4ba3-bc0d-e0935ff2155c

	/// Total market units traded on the latest day in selection (the 'Units Traded' KPI).
	measure 'Daily Volume' = CALCULATE ( [Total Market Volume], LASTDATE ( DimDate[Date] ) )
		formatString: #,##0
		displayFolder: 05. Volume & liquidity
		lineageTag: 04f38427-beb5-4020-b68e-49f27ddd42d0

	/// Liquidity proxy: value-weighted daily range (AVG High - AVG Low) / AVG price on the latest day. Aggregate form so penny items don't dominate.
	measure 'Avg Bid-Ask Spread %' = CALCULATE ( [Daily Range %], LASTDATE ( DimDate[Date] ) )
		formatString: 0.0%
		displayFolder: 04. Price action
		lineageTag: 2757b83f-ed1c-461d-a2d4-5ce083e62c23

	/// Breadth headline 'advancing/declining', e.g. '392/278'.
	measure 'Lbl Breadth AD' = FORMAT ( [Advancing Items], "#,##0" ) & "/" & FORMAT ( [Declining Items], "#,##0" )
		displayFolder: 18. Labels
		lineageTag: 0502c2fe-3779-40e6-9e11-c846d454173f

	/// e.g. '↑ +1.4% vs prior day' — caption under Daily Turnover.
	measure 'Lbl Turnover vs Prior Day' =
			VAR v = [Turnover vs Prior Day %]
			RETURN IF ( v >= 0, "↑ ", "↓ " ) & FORMAT ( v, "+0.0%;-0.0%" ) & " vs prior day"
		displayFolder: 18. Labels
		lineageTag: 145781e2-41f6-4e56-9ca1-e3861ca61e4a

	/// Static caption for the Active Listings KPI card.
	measure 'Lbl Open Sell Orders' = "open sell orders"
		displayFolder: 18. Labels
		lineageTag: bbfacbe8-7839-45f4-b59a-ee08fe4ccbf6

	/// Static caption for the Avg Bid-Ask Spread KPI card.
	measure 'Lbl Liquidity Proxy' = "liquidity proxy"
		displayFolder: 18. Labels
		lineageTag: 0b091616-a004-4af9-ae0f-1b170443364e

	/// Breadth — advancing only, e.g. '↑ 392 advancing'. Style green.
	measure 'Lbl Advancing' = "↑ " & FORMAT ( [Advancing Items], "#,##0" ) & " advancing"
		displayFolder: 18. Labels
		lineageTag: 862cc833-90df-4253-9e53-4e3a48fd08c4

	/// Breadth — declining only, e.g. '↓ 278 declining'. Style red.
	measure 'Lbl Declining' = "↓ " & FORMAT ( [Declining Items], "#,##0" ) & " declining"
		displayFolder: 18. Labels
		lineageTag: bc029b4c-bbbc-4664-9505-c24df9a412a0

	/// Breadth — unchanged only, e.g. '50 flat'. Style grey.
	measure 'Lbl Unchanged' = FORMAT ( [Unchanged Items], "#,##0" ) & " flat"
		displayFolder: 18. Labels
		lineageTag: 2a14dc74-1a79-47f7-a631-f33bcda7fc96

	/// Ultra-dense animated starfield (1280×720). 100 faint static + 65 distant + 35 mid + 18 bright (size-pulse) + 3 cluster knots (30 stars) ≈ 248 stars, 3 nebula blobs, 4 shooting stars. Pure SVG SMIL — works in Image visual AND HTML Content custom visual. Asset: bg-stars-ultra.svg.
