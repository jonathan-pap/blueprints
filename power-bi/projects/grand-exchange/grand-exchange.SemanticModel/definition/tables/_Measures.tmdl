	/// Reagent category rollup icon (64×64, gold). Asset: assets/fantasy-ui/items/cat-reagent.svg.
	measure 'SVG · Category Icon · Reagent' = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64' width='64' height='64'>" & "<path d='M32 6 Q18 28 18 42 Q18 56 32 58 Q46 56 46 42 Q46 28 32 6 Z' fill='none' stroke='#E8C24A' stroke-width='2.5' stroke-linejoin='round'/><path d='M32 22 Q24 36 24 44 Q24 52 32 54 Q40 52 40 44 Q40 36 32 22' fill='#E8C24A' opacity='0.4'/><ellipse cx='28' cy='40' rx='3' ry='5' fill='#E8C24A' opacity='0.7'/>" & "</svg>"
		displayFolder: 14. Fantasy Chrome\Category Icons
		lineageTag: 42c105fb-899d-4718-9d94-2be6cfb1ea90
		dataCategory: ImageUrl

	/// Misc category rollup icon (64×64, gold). Asset: assets/fantasy-ui/items/cat-misc.svg.
	measure 'SVG · Category Icon · Misc' = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64' width='64' height='64'>" & "<path d='M32 6 L38 24 L58 24 L42 36 L48 56 L32 44 L16 56 L22 36 L6 24 L26 24 Z' fill='none' stroke='#E8C24A' stroke-width='2.5' stroke-linejoin='round'/><path d='M32 16 L36 24 L44 24 L38 30 L40 38 L32 34 L24 38 L26 30 L20 24 L28 24 Z' fill='#E8C24A' opacity='0.4'/><circle cx='32' cy='30' r='3' fill='#E8C24A'/>" & "</svg>"
		displayFolder: 14. Fantasy Chrome\Category Icons
		lineageTag: a493749e-7233-4a32-a5b8-abf0cb2f6e8e
		dataCategory: ImageUrl

	/// Composite exchange price level, base 1000 at the first date in the model (avg ClosePrice across items, rebased). Plot on the 120-day trend line.
	measure 'Exchange Index' =
			VAR _baseDate = CALCULATE ( MIN ( DimDate[Date] ), ALL ( DimDate ) )
			VAR _base = CALCULATE ( AVERAGE ( FactMarketPriceDaily[ClosePrice] ), ALL ( DimDate ), DimDate[Date] = _baseDate )
			VAR _cur = AVERAGE ( FactMarketPriceDaily[ClosePrice] )
			RETURN DIVIDE ( _cur, _base ) * 1000
		formatString: #,##0
		displayFolder: 15. Index & Breadth
		lineageTag: 3ea7de1d-7739-45a2-9307-599b2bc5e9de

	/// Index change vs the previous day (as of the latest date in selection). KPI card.
	measure 'Exchange Index vs Prior Day %' =
			VAR _cur = CALCULATE ( [Exchange Index], LASTDATE ( DimDate[Date] ) )
			VAR _prev = CALCULATE ( [Exchange Index], DATEADD ( LASTDATE ( DimDate[Date] ), -1, DAY ) )
			RETURN DIVIDE ( _cur - _prev, _prev )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 15. Index & Breadth
		lineageTag: d11e6e35-d2c7-40cb-a136-5b8dcba053f8

	/// Index change vs 30 days ago (as of the latest date in selection). KPI card.
	measure 'Exchange Index 30D %' =
			VAR _cur = CALCULATE ( [Exchange Index], LASTDATE ( DimDate[Date] ) )
			VAR _prev = CALCULATE ( [Exchange Index], DATEADD ( LASTDATE ( DimDate[Date] ), -30, DAY ) )
			RETURN DIVIDE ( _cur - _prev, _prev )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 15. Index & Breadth
		lineageTag: eaa521fc-a9cb-4cc3-b017-4984d6da22e7

	/// Count of items whose close rose vs the prior day (latest day in selection). Market breadth.
	measure 'Advancing Items' =
			VAR _d = LASTDATE ( DimDate[Date] )
			RETURN COUNTROWS ( FILTER ( VALUES ( DimItem[ItemKey] ), VAR _c = CALCULATE ( SUM ( FactMarketPriceDaily[ClosePrice] ), _d ) VAR _p = CALCULATE ( SUM ( FactMarketPriceDaily[ClosePrice] ), DATEADD ( _d, -1, DAY ) ) RETURN _p > 0 && _c > _p ) )
		formatString: #,##0
		displayFolder: 15. Index & Breadth
		lineageTag: dea17f69-baa3-4db7-99c1-10c6c07b7da0

	/// Count of items whose close fell vs the prior day (latest day). Market breadth.
	measure 'Declining Items' =
			VAR _d = LASTDATE ( DimDate[Date] )
			RETURN COUNTROWS ( FILTER ( VALUES ( DimItem[ItemKey] ), VAR _c = CALCULATE ( SUM ( FactMarketPriceDaily[ClosePrice] ), _d ) VAR _p = CALCULATE ( SUM ( FactMarketPriceDaily[ClosePrice] ), DATEADD ( _d, -1, DAY ) ) RETURN _c > 0 && _p > 0 && _c < _p ) )
		formatString: #,##0
		displayFolder: 15. Index & Breadth
		lineageTag: f999eba2-e6a0-46ca-9dfd-bc1afe22414f

	/// Count of items whose close was unchanged vs the prior day (latest day). Market breadth.
	measure 'Unchanged Items' =
			VAR _d = LASTDATE ( DimDate[Date] )
			RETURN COUNTROWS ( FILTER ( VALUES ( DimItem[ItemKey] ), VAR _c = CALCULATE ( SUM ( FactMarketPriceDaily[ClosePrice] ), _d ) VAR _p = CALCULATE ( SUM ( FactMarketPriceDaily[ClosePrice] ), DATEADD ( _d, -1, DAY ) ) RETURN _p > 0 && _c = _p ) )
		formatString: #,##0
		displayFolder: 15. Index & Breadth
		lineageTag: bb278f13-fa52-44ba-bc21-d3c0430fba20

	/// Advancing ÷ Declining items. >1 = broadly bullish session.
	measure 'Advance/Decline Ratio' = DIVIDE ( [Advancing Items], [Declining Items] )
		formatString: 0.00
		displayFolder: 15. Index & Breadth
		lineageTag: 6e788dc6-6ef3-4990-bd89-21eba8e69e31

	/// Item price change vs 30 days ago (close, as of latest date in selection). Drives Top Gainers/Losers 30D and the Most Traded 30D column.
	measure 'Close vs 30D %' =
			VAR _cur = CALCULATE ( AVERAGE ( FactMarketPriceDaily[ClosePrice] ), LASTDATE ( DimDate[Date] ) )
			VAR _prev = CALCULATE ( AVERAGE ( FactMarketPriceDaily[ClosePrice] ), DATEADD ( LASTDATE ( DimDate[Date] ), -30, DAY ) )
			RETURN DIVIDE ( _cur - _prev, _prev )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04. Price action
		lineageTag: 9c7a5b2c-6687-4cd4-81c8-7f08e42beb88

	/// Trailing 7-day average price (per item). Market Board '7D Avg' column.
	measure 'Avg Price 7D' = CALCULATE ( AVERAGE ( FactMarketPriceDaily[AvgPrice] ), DATESINPERIOD ( DimDate[Date], LASTDATE ( DimDate[Date] ), -7, DAY ) )
		formatString: "₡"#,##0
		displayFolder: 16. Market Board
		lineageTag: 71d38f3d-572c-4b28-bbaa-65577d0711a7

	/// Trailing 7-day gold value traded (per item). Market Board 'Gold Vol 7D' column.
	measure 'Trade Value 7D' = CALCULATE ( [Total Trade Value], DATESINPERIOD ( DimDate[Date], LASTDATE ( DimDate[Date] ), -7, DAY ) )
		formatString: "₡"#,##0
		displayFolder: 16. Market Board
		lineageTag: 3bf6f229-1df7-407c-b56a-b47cb6b66e24

	/// Trailing 7-day units sold (per item). Market Board 'Sold 7D' column.
	measure 'Trade Quantity 7D' = CALCULATE ( [Trade Quantity], DATESINPERIOD ( DimDate[Date], LASTDATE ( DimDate[Date] ), -7, DAY ) )
		formatString: #,##0
		displayFolder: 16. Market Board
		lineageTag: 76bf87a3-faa1-4055-9cb2-ecdb76f9a40f

	/// Lowest price on the latest day in selection (per item). Market Board 'Low Price' column.
	measure 'Current Low' = CALCULATE ( MIN ( FactMarketPriceDaily[LowPrice] ), LASTDATE ( DimDate[Date] ) )
		formatString: "₡"#,##0
		displayFolder: 16. Market Board
		lineageTag: b5d9f53c-ecb0-46cb-81f7-58537b1289ea

	/// Active listings on the latest day in selection (per item). Market Board 'Qty for Sale' column.
	measure 'Listings (latest)' = CALCULATE ( SUM ( FactMarketPriceDaily[ListingsCount] ), LASTDATE ( DimDate[Date] ) )
		formatString: #,##0
		displayFolder: 16. Market Board
		lineageTag: 7160ebc7-72e2-46df-80ac-d8c281c4324c

	/// 7D average minus current low — cheapness/discount signal (per item). Market Board 'Avg − Low' column.
	measure 'Avg minus Low 7D' = [Avg Price 7D] - [Current Low]
		formatString: +"₡"#,##0;-"₡"#,##0;"₡"0
		displayFolder: 16. Market Board
		lineageTag: 17af1a6a-4248-4a12-a3e3-a08c047db21b

	/// SVG pill badge for the rarity in context (item row or rarity row). Tinted fill + colored border/text. Colors: Common grey, Uncommon green, Rare blue, Epic purple, Legendary orange, Mythic red. Bind in a table column with Image URL rendering.
	measure 'Rarity Chip' =
			VAR _rk = COALESCE ( SELECTEDVALUE ( DimItem[RarityKey] ), SELECTEDVALUE ( DimRarity[RarityKey] ) )
			VAR _name = LOOKUPVALUE ( DimRarity[RarityName], DimRarity[RarityKey], _rk )
			VAR _color =
			    SWITCH ( _name,
			        "Common", "rgb(156,163,175)",
			        "Uncommon", "rgb(34,197,94)",
			        "Rare", "rgb(59,130,246)",
			        "Epic", "rgb(168,85,247)",
			        "Legendary", "rgb(245,158,11)",
			        "Mythic", "rgb(239,68,68)",
			        "rgb(156,163,175)"
			    )
			VAR _svg =
			    "data:image/svg+xml;utf8," &
			    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 28'>" &
			    "<rect x='1.5' y='1.5' width='117' height='25' rx='12.5' fill='" & _color & "' fill-opacity='0.18' stroke='" & _color & "' stroke-width='1.5'/>" &
			    "<text x='60' y='19' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='700' letter-spacing='0.5' fill='" & _color & "' text-anchor='middle'>" & UPPER ( _name ) & "</text>" &
			    "</svg>"
			RETURN IF ( NOT ISBLANK ( _name ), _svg )
		displayFolder: 17. Chips & Badges
		lineageTag: 305c2c85-3bf8-4c6e-825d-e94982d7c693
		dataCategory: ImageUrl

	/// e.g. 'last session Jun 5, 2026' — latest date in selection.
	measure 'Lbl Last Session' = "last session " & FORMAT ( MAX ( DimDate[Date] ), "MMM d, yyyy" )
		displayFolder: 18. Labels
		lineageTag: 330ead2f-5832-4e56-9dca-5336bc72a2c6

	/// Header refresh stamp, e.g. 'Last refresh: Jun 5, 2026 · 06:00 UTC' (date from data; time is a fixed session label).
	measure 'Lbl Last Refresh' = "Last refresh: " & FORMAT ( MAX ( DimDate[Date] ), "MMM d, yyyy" ) & "  ·  06:00 UTC"
		displayFolder: 18. Labels
		lineageTag: 35f7a0c9-e8c2-4dd2-99be-2c89a97fd099

	/// Page subtitle: 'Exchange-wide price, volume & breadth · last session <date>'.
	measure 'Lbl Market Watch Subtitle' = "Exchange-wide price, volume & breadth   ·   last session " & FORMAT ( MAX ( DimDate[Date] ), "MMM d, yyyy" )
		displayFolder: 18. Labels
		lineageTag: 5897a37d-e118-455c-9436-0f2ee01ebea5

	/// e.g. '↑ 392 advancing · ↓ 278 declining · 50 flat'.
	measure 'Lbl Breadth Summary' = "↑ " & " advancing    ·    ↓ " & " decline "
		displayFolder: 18. Labels
		lineageTag: 10290e97-debd-4877-bd82-1ca27ad88575

	/// e.g. 'Advance/decline ratio 1.41 — broadly bullish session.'
	measure 'Lbl AD Sentence' =
			VAR r = [Advance/Decline Ratio]
			VAR mood = SWITCH ( TRUE (), r >= 1.2, "broadly bullish session", r >= 1.0, "mildly positive session", r >= 0.8, "mildly negative session", "broadly bearish session" )
			RETURN "Advance/decline ratio " & FORMAT ( r, "0.00" ) & " — " & mood & "."
		displayFolder: 18. Labels
		lineageTag: 61073829-4a0b-42ac-bf54-756af5cabea3

	/// e.g. '↑ +7.4% vs 30D' (arrow + Exchange Index 30D %).
	measure 'Lbl Index vs 30D' =
			VAR v = [Exchange Index 30D %]
			RETURN IF ( v >= 0, "↑ ", "↓ " ) & FORMAT ( v, "+0.0%;-0.0%" ) & " vs 30D"
		displayFolder: 18. Labels
		lineageTag: eb7cfc6e-ef5b-47a2-a216-637d1269f4a8

	/// e.g. '↑ +1.4% vs prior day'.
	measure 'Lbl Index vs Prior Day' =
			VAR v = [Exchange Index vs Prior Day %]
			RETURN IF ( v >= 0, "↑ ", "↓ " ) & FORMAT ( v, "+0.0%;-0.0%" ) & " vs prior day"
		displayFolder: 18. Labels
		lineageTag: 4d4b188f-5c8f-4064-9a5e-02523de91fdd

	/// e.g. 'across 720 tracked items' — distinct items traded on the latest day in selection.
	measure 'Lbl Tracked Items' = "across " & FORMAT ( CALCULATE ( DISTINCTCOUNT ( FactTrade[ItemKey] ), LASTDATE ( DimDate[Date] ) ), "#,##0" ) & " tracked items"
		displayFolder: 18. Labels
		lineageTag: 616de560-ce77-4cb2-a605-04f48cdb328c

	/// e.g. 'Index = 1,000 base · Jan 2022' (first date in the model).
	measure 'Lbl Index Base' = "Index = 1,000 base  ·  " & FORMAT ( CALCULATE ( MIN ( DimDate[Date] ), ALL ( DimDate ) ), "MMM yyyy" )
		displayFolder: 18. Labels
		lineageTag: edae33de-25dd-408b-bc9b-3c55bcd2a6ba

	/// Selected Range button label (defaults to 3M). Use in dynamic titles once the period selector is wired.
	measure 'Period Label' = COALESCE ( SELECTEDVALUE ( Range[Label] ), "3M" )
		displayFolder: 18. Labels
		lineageTag: 78091e83-9612-472b-a79f-8728c9f113f9

	/// Market Board subtitle (realm removed): 'Live sell listings across the exchange — search, sort & track items'.
	measure 'Lbl Market Board Subtitle' = "Live sell listings across the exchange   ·   search, sort & track items"
		displayFolder: 18. Labels
		lineageTag: c3c7773f-2db0-40cf-be1d-276224e3a52e

