/// Disconnected helper for quick-select date-range buttons.
table Range
	lineageTag: c7a53b95-3da2-418b-91a3-0255a1f320a2

	column Label
		lineageTag: a52648a1-82ea-461e-8d01-41528d11ac3b
		isNameInferred
		sourceColumn: [Label]
		sortByColumn: SortOrder

	column DaysBack
		isHidden
		lineageTag: 8a2bd614-2ce5-47ce-abec-b094b244060d
		isNameInferred
		sourceColumn: [DaysBack]

	column SortOrder
		isHidden
		lineageTag: 7ea95e0d-04bd-437b-9970-bb2aabf8f781
		isNameInferred
		sourceColumn: [SortOrder]

	partition Range = calculated
		mode: import
		source = UNION ( ROW ( "Label", "1D",  "DaysBack", 1,     "SortOrder", 1 ), ROW ( "Label", "5D",  "DaysBack", 5,     "SortOrder", 2 ), ROW ( "Label", "1M",  "DaysBack", 30,    "SortOrder", 3 ), ROW ( "Label", "3M",  "DaysBack", 90,    "SortOrder", 4 ), ROW ( "Label", "6M",  "DaysBack", 180,   "SortOrder", 5 ), ROW ( "Label", "YTD", "DaysBack", -1,    "SortOrder", 6 ), ROW ( "Label", "1Y",  "DaysBack", 365,   "SortOrder", 7 ), ROW ( "Label", "2Y",  "DaysBack", 730,   "SortOrder", 8 ), ROW ( "Label", "5Y",  "DaysBack", 1825,  "SortOrder", 9 ), ROW ( "Label", "ALL", "DaysBack", 99999, "SortOrder", 10 ) )

