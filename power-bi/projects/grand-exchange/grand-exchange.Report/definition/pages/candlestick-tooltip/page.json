{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "candlestick-tooltip",
  "displayName": "Candlestick Tooltip",
  "displayOption": "FitToPage",
  "height": 180,
  "width": 218,
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#FFFFFF'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "100D"
              }
            }
          }
        }
      }
    ],
    "displayArea": [
      {
        "properties": {
          "verticalAlignment": {
            "expr": {
              "Literal": {
                "Value": "'Top'"
              }
            }
          }
        }
      }
    ],
    "outspace": [
      {
        "properties": {
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ],
    "outspacePane": [
      {
        "properties": {
          "border": {
            "expr": {
              "Literal": {
                "Value": "false"
              }
            }
          }
        }
      }
    ]
  },
  "visibility": "HiddenInViewMode",
  "type": "Tooltip"
}