		lineageTag: 15fccfa2-70b9-4142-ab1a-5d0c37cd683a

	measure 'Avg LootGoldValue' = DIVIDE ( [Total LootGoldValue], [LootDrops] )
		formatString: #,##0.0
		displayFolder: Core
		lineageTag: 57c34f08-4f6c-4780-82f7-e6b5ca13ab9e

	measure 'Total GoldVolume' = SUM ( FactMarketTrades[GoldVolume] )
		formatString: #,##0
		displayFolder: Core
		lineageTag: c04abe57-094b-4e65-a9ae-c3a23be45f33

	measure 'Total QuantityTraded' = SUM ( FactMarketTrades[QuantityTraded] )
		formatString: #,##0
		displayFolder: Core
		lineageTag: bfbc8d69-5a73-47f4-871e-e67cedbc33f4

	measure 'Total AvgUnitPrice' = SUM ( FactMarketTrades[AvgUnitPrice] )
		formatString: #,##0
		displayFolder: Core
		lineageTag: 6e27ca87-861e-4b63-9709-4a3a497344eb

	measure MarketTrades = COUNTROWS ( FactMarketTrades )
		formatString: #,##0
		displayFolder: Core
		lineageTag: cfd04364-f467-4b05-9e03-8bce08360d61

	measure 'Avg GoldVolume' = DIVIDE ( [Total GoldVolume], [MarketTrades] )
		formatString: #,##0.0
		displayFolder: Core
		lineageTag: 833628fd-ab1a-46e3-a93e-983677ebc5ae

	measure 'Avg QuantityTraded' = DIVIDE ( [Total QuantityTraded], [MarketTrades] )
		formatString: #,##0.0
		displayFolder: Core
		lineageTag: 1859c9ca-5c41-4bce-b551-6ed4189dfdac

	measure 'Avg AvgUnitPrice' = DIVIDE ( [Total AvgUnitPrice], [MarketTrades] )
		formatString: #,##0.0
		displayFolder: Core
		lineageTag: bc540ac7-af0a-4945-8de3-450b82ed5932

	column _
		lineageTag: b5113f9d-d207-40fa-8021-0199f0851762
		isNameInferred
		sourceColumn: [_]

	partition _Measures = calculated
		mode: import
		source = ROW ( "_", "" )

