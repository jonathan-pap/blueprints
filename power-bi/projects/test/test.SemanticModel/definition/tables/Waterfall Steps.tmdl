table 'Waterfall Steps'
	lineageTag: a34a01e8-04e3-4411-8033-6a958901caca

	column Step
		lineageTag: 9b43e958-06ca-42ea-9669-c84854e2989d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Step]
		sortByColumn: StepSort

	column StepSort
		isHidden
		lineageTag: 2943e946-7574-4e8b-aef8-229dc5218308
		summarizeBy: none
		isNameInferred
		sourceColumn: [StepSort]

	partition 'Waterfall Steps' = calculated
		mode: import
		source =
				UNION (
					SELECTCOLUMNS ( { ( "Sales", 1 ) }, "Step", [Value1], "StepSort", [Value2] ),
					SELECTCOLUMNS ( { ( "COGS", 2 ) }, "Step", [Value1], "StepSort", [Value2] ),
					SELECTCOLUMNS ( { ( "Profit", 3 ) }, "Step", [Value1], "StepSort", [Value2] )
				)

