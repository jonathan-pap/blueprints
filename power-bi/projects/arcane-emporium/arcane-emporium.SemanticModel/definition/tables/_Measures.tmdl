/// Measure home. A one-row calculated table so every measure lives in one place in the field list instead of scattered across the fact and dimensions.
table _Measures
	lineageTag: 02b4d60f-5dbd-4a93-a2d5-41a88aa0f1b6

	/// Gold revenue. Named Total Gold rather than Gold because FactSales already has a hidden [Gold] column - a measure and a column sharing a name makes the unqualified reference ambiguous to read even where DAX allows it.
	measure 'Total Gold' = SUM ( FactSales[Gold] )
		formatString: #,##0
		displayFolder: Core
		lineageTag: e5a190a4-2b0f-4425-80dc-8a6e8f4de631

	measure 'Total Units' = SUM ( FactSales[Units] )
		formatString: #,##0
		displayFolder: Core
		lineageTag: ab0bd7ae-c6c6-49f2-9695-8fa0df9d4778

	/// One fact row is one sale line - a customer buying one item at one shop on one day.
	measure Transactions = COUNTROWS ( FactSales )
		formatString: #,##0
		displayFolder: Core
		lineageTag: 1372647d-d29d-4f09-9e66-63f58ab73c66

	/// Gold per transaction line.
	measure 'Avg Sale' = DIVIDE ( [Total Gold], [Transactions] )
		formatString: #,##0
		displayFolder: Core
		lineageTag: 56fb45eb-4089-45f3-8d8c-ded3e83db8c2

	/// Gold per unit sold - the blended price across whatever is in filter context.
	measure 'Avg Item Price' = DIVIDE ( [Total Gold], [Total Units] )
		formatString: #,##0
		displayFolder: Core
		lineageTag: 1ff3428d-8838-4823-ba03-7b96495cb141

	/// Distinct customers who bought in the current filter context. Counted off the fact, not the dimension, so a filtered period does not report patrons who bought nothing.
	measure Patrons = DISTINCTCOUNT ( FactSales[CustomerKey] )
		formatString: #,##0
		displayFolder: Core
		lineageTag: 70a91830-657f-4c7c-a22b-5f8eda11994c

	/// Distinct items with at least one sale in context.
	measure 'Items Sold' = DISTINCTCOUNT ( FactSales[ItemKey] )
		formatString: #,##0
		displayFolder: Core
		lineageTag: fd0ef0d4-0318-4431-b3e2-08795dbf2aaf

	/// Same period last year. DimDate is marked as a date table, so the time-intelligence functions work off DimDate[Date] even though the fact joins on the integer DateKey.
	measure 'Gold PY' = CALCULATE ( [Total Gold], SAMEPERIODLASTYEAR ( DimDate[Date] ) )
		formatString: #,##0
		displayFolder: Time
		lineageTag: 308e4153-64f0-49e8-ac84-fd3d3ee8add9

	measure 'Gold YoY' =
			VAR _py = [Gold PY]
			RETURN
			    IF ( NOT ISBLANK ( _py ), [Total Gold] - _py )
		formatString: +#,##0;-#,##0;0
		displayFolder: Time
		lineageTag: 4bd42fd7-a0d3-461e-8b5a-6bbb92f01629

	/// Blank rather than zero in 2023 - there is no prior year in the data, and a 0% that means 'no comparison' is a lie a reader cannot see.
	measure 'Gold YoY %' =
			VAR _py = [Gold PY]
			RETURN
			    DIVIDE ( [Total Gold] - _py, _py )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time
		lineageTag: d5c57a07-eb2b-4f4f-8f5e-0c9a5012d753

	measure 'Gold YTD' = TOTALYTD ( [Total Gold], DimDate[Date] )
		formatString: #,##0
		displayFolder: Time
		lineageTag: 5d2502be-c1b1-4e92-bf73-799382899679

	/// Trailing three-month mean of monthly Gold - smooths the Frostfall spike enough to see the underlying trend beside it.
	measure 'Gold 3M Avg' =
			VAR _end = MAX ( DimDate[Date] )
			VAR _win =
			    DATESINPERIOD ( DimDate[Date], _end, -3, MONTH )
			RETURN
			    DIVIDE ( CALCULATE ( [Total Gold], _win ), 3 )
		formatString: #,##0
		displayFolder: Time
		lineageTag: 683b2ef7-0133-400c-835c-479359d0b5a7

	/// This slice against everything currently selected. ALLSELECTED rather than ALL so the share re-bases when the reader filters, instead of quietly staying a share of the whole four years.
	measure 'Gold Share of Total' = DIVIDE ( [Total Gold], CALCULATE ( [Total Gold], ALLSELECTED ( ) ) )
		formatString: 0.0%
		displayFolder: Analysis
		lineageTag: 2ddba0d0-ec1c-41cc-aa8f-cb70d7d3549f

	/// Names whatever the three header slicers currently have selected. A textbox cannot read filter context, so the header caption has to be a card bound to a measure. SELECTEDVALUE's alternate result covers both 'nothing selected' and 'several selected'.
	measure 'Selection Caption' =
			VAR _r = SELECTEDVALUE ( DimShop[Realm], "All realms" )
			VAR _c = SELECTEDVALUE ( DimItem[Category], "All wares" )
			VAR _y = SELECTEDVALUE ( DimDate[Year] )
			VAR _yt = IF ( ISBLANK ( _y ), "2023 – 2026", FORMAT ( _y, "0" ) )
			RETURN
			    _r & "   ·   " & _c & "   ·   " & _yt
		displayFolder: Report
		lineageTag: f8cafd95-e655-458f-915d-2dcc1d0ce52c

	/// Per-bar fill for realm-coloured charts. Must be bound through dataPoint.fill with a dataViewWildcard selector or every bar renders identically.
	measure 'Realm Colour' =
			SWITCH (
			    SELECTEDVALUE ( DimShop[Realm] ),
			    "Eldoria", "#B2C6ED",
			    "Grimmwald", "#B74BC3",
			    "Sunspire", "#C7A726",
			    "#5F6E7E"
			)
		displayFolder: Report
		lineageTag: 4c1a6f2e-9b30-4d71-8a55-6e1c93b7d240

	/// Per-bar fill for category-coloured charts, drawn from the Runeforge Dark data palette.
	measure 'Category Colour' =
			SWITCH (
			    SELECTEDVALUE ( DimItem[Category] ),
			    "Potions", "#33A095",
			    "Enchanted Weapons", "#E9A7B0",
			    "Scrolls", "#B2C6ED",
			    "Artifacts", "#B74BC3",
			    "Reagents", "#BF7240",
			    "#5F6E7E"
			)
		displayFolder: Report
		lineageTag: 9d2b41c7-6e08-4f13-b2aa-70c5e8d1af36

	/// Growth of the LATEST year in view against the year before it. [Gold YoY %] is correct only at a single-year grain: with all four years in context SAMEPERIODLASTYEAR compares 2023-2026 against 2023-2025 and reports +41.6%, which is arithmetic rather than a growth rate. This one always answers 'how did the most recent year do', whatever the grain. REMOVEFILTERS(DimDate) is required so the prior year is still reachable when a year slicer is set.
	measure 'Gold YoY % Latest' =
			VAR _y = MAX ( DimDate[Year] )
			VAR _cur =
			    CALCULATE ( [Total Gold], REMOVEFILTERS ( DimDate ), DimDate[Year] = _y )
			VAR _pre =
			    CALCULATE ( [Total Gold], REMOVEFILTERS ( DimDate ), DimDate[Year] = _y - 1 )
			RETURN
			    DIVIDE ( _cur - _pre, _pre )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time
		lineageTag: 227b7d71-9a38-4511-8f1b-30cd78259144

	/// Coach-mark bubble for tutorial step 02. GENERATED by build_bubbles.py.
	measure 'Bubble 02' = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='680' height='221'><defs><filter id='s' x='-20%' y='-20%' width='140%' height='140%'><feDropShadow dx='0' dy='3' stdDeviation='6' flood-color='#000' flood-opacity='0.55'/></filter></defs><path d='M 14 18 L 322 18 L 340 0 L 358 18 L 666 18 A 14 14 0 0 1 680 32 L 680 207 A 14 14 0 0 1 666 221 L 14 221 A 14 14 0 0 1 0 207 L 0 32 A 14 14 0 0 1 14 18 Z' fill='#221E1A' stroke='#C7A726' stroke-width='2' filter='url(#s)'/><foreignObject x='22' y='40' width='636' height='159'><div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI,Segoe,sans-serif;color:#CDC2B4;font-size:13px;line-height:1.5'><div style='color:#9E9285;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;margin-bottom:5px'>Step 2 of 3</div><div style='color:#C7A726;font-size:17px;font-weight:600;line-height:1.25;margin-bottom:9px'>Four years, month by month</div><div>Columns are each month&#39;s take; the gold line is a trailing three-month mean.<br/><br/>The line exists so the spikes read as spikes rather than as the trend moving. Every November and December is the <b>Frostfall festival</b>.</div></div></foreignObject></svg>"
		displayFolder: Tutorial
		lineageTag: ca0d9a4e-8bc8-41db-8bbb-887798f37233
		dataCategory: ImageUrl

	/// Coach-mark bubble, tail on the BOTTOM. GENERATED by build_bubbles.py.
	measure 'Bubble 03' = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='680' height='241'><defs><filter id='s' x='-20%' y='-20%' width='140%' height='140%'><feDropShadow dx='0' dy='3' stdDeviation='6' flood-color='#000' flood-opacity='0.55'/></filter></defs><path d='M 14 0 L 666 0 A 14 14 0 0 1 680 14 L 680 209 A 14 14 0 0 1 666 223 L 154 223 L 136 241 L 118 223 L 14 223 A 14 14 0 0 1 0 209 L 0 14 A 14 14 0 0 1 14 0 Z' fill='#221E1A' stroke='#C7A726' stroke-width='2' filter='url(#s)'/><foreignObject x='22' y='22' width='636' height='179'><div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI,Segoe,sans-serif;color:#CDC2B4;font-size:13px;line-height:1.5'><div style='color:#9E9285;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;margin-bottom:5px'>Step 3 of 3</div><div style='color:#C7A726;font-size:17px;font-weight:600;line-height:1.25;margin-bottom:9px'>Two ways to cut the same Gold</div><div>Realm on the left, category of ware on the right. Both splits are pinned by the generator - 45/30/25 and 30/25/20/15/10 - and the model reproduces them to eight decimal places.<br/><br/>One is horizontal and one vertical for a dull reason: five horizontal bars did not fit, and Power BI drops the fifth rather than crowd them.</div></div></foreignObject></svg>"
		displayFolder: Tutorial
		lineageTag: ca29c29a-cd2b-4320-ad3d-400b7e0f7fd8
		dataCategory: ImageUrl

	/// Coach-mark bubble, tail on the LEFT. GENERATED by build_bubbles.py.
	measure 'Bubble 04' = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='640' height='221'><defs><filter id='s' x='-20%' y='-20%' width='140%' height='140%'><feDropShadow dx='0' dy='3' stdDeviation='6' flood-color='#000' flood-opacity='0.55'/></filter></defs><path d='M 32 0 L 626 0 A 14 14 0 0 1 640 14 L 640 207 A 14 14 0 0 1 626 221 L 32 221 A 14 14 0 0 1 18 207 L 18 88 L 0 70 L 18 52 L 18 14 A 14 14 0 0 1 32 0 Z' fill='#221E1A' stroke='#C7A726' stroke-width='2' filter='url(#s)'/><foreignObject x='40' y='22' width='578' height='177'><div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI,Segoe,sans-serif;color:#CDC2B4;font-size:13px;line-height:1.5'><div style='color:#9E9285;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;margin-bottom:5px'>Step 1 of 2</div><div style='color:#C7A726;font-size:17px;font-weight:600;line-height:1.25;margin-bottom:9px'>Every shop, ranked</div><div>Bar colour is the realm - Eldoria blue, Grimmwald plum, Sunspire gold.<br/><br/><b>Read the realms, not the shops.</b> Within a realm they are near-identical (3,750,001 / 3,750,000 / 3,749,999) because the generator splits each realm&#39;s Gold evenly across its shops.</div></div></foreignObject></svg>"
		displayFolder: Tutorial
		lineageTag: 5471fba3-9fac-46c2-aa4f-09019dc2259e
		dataCategory: ImageUrl

	/// Coach-mark bubble, tail on the RIGHT. GENERATED by build_bubbles.py.
	measure 'Bubble 05' = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='448' height='241'><defs><filter id='s' x='-20%' y='-20%' width='140%' height='140%'><feDropShadow dx='0' dy='3' stdDeviation='6' flood-color='#000' flood-opacity='0.55'/></filter></defs><path d='M 14 0 L 416 0 A 14 14 0 0 1 430 14 L 430 59 L 448 77 L 430 95 L 430 227 A 14 14 0 0 1 416 241 L 14 241 A 14 14 0 0 1 0 227 L 0 14 A 14 14 0 0 1 14 0 Z' fill='#221E1A' stroke='#C7A726' stroke-width='2' filter='url(#s)'/><foreignObject x='22' y='22' width='386' height='197'><div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI,Segoe,sans-serif;color:#CDC2B4;font-size:13px;line-height:1.5'><div style='color:#9E9285;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;margin-bottom:5px'>Step 2 of 2</div><div style='color:#C7A726;font-size:17px;font-weight:600;line-height:1.25;margin-bottom:9px'>The shop ledger</div><div>Share re-bases to whatever the header slicers have selected. Pick one realm and each of its shops jumps from 15% to 33%.<br/><br/>It is always a share of what you are looking at, never a share of the whole four years.</div></div></foreignObject></svg>"
		displayFolder: Tutorial
		lineageTag: 96b5b03b-3298-4a1b-baf3-51ee5d24f60c
		dataCategory: ImageUrl

	/// Coach-mark bubble. GENERATED by build_bubbles.py.
	measure 'Bubble 06' = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='744' height='241'><defs><filter id='s' x='-20%' y='-20%' width='140%' height='140%'><feDropShadow dx='0' dy='3' stdDeviation='6' flood-color='#000' flood-opacity='0.55'/></filter></defs><path d='M 14 18 L 190 18 L 208 0 L 226 18 L 730 18 A 14 14 0 0 1 744 32 L 744 227 A 14 14 0 0 1 730 241 L 14 241 A 14 14 0 0 1 0 227 L 0 32 A 14 14 0 0 1 14 18 Z' fill='#221E1A' stroke='#C7A726' stroke-width='2' filter='url(#s)'/><foreignObject x='22' y='40' width='700' height='179'><div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI,Segoe,sans-serif;color:#CDC2B4;font-size:13px;line-height:1.5'><div style='color:#9E9285;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;margin-bottom:5px'>Step 1 of 2</div><div style='color:#C7A726;font-size:17px;font-weight:600;line-height:1.25;margin-bottom:9px'>The vital few</div><div>Bars are Gold, the line is the running share. Gold to the 80% mark, iron beyond it: four wares carry over half the takings.<br/><br/>The line is a <b>visual calculation</b> - nothing was added to the model. ORDERBY pins accumulation to value-descending, so it stays correct even if you re-sort the axis.</div></div></foreignObject></svg>"
		displayFolder: Tutorial
		lineageTag: 8189a25b-eda8-4e6c-9c31-a770b8b534fa
		dataCategory: ImageUrl

	/// Coach-mark bubble. GENERATED by build_bubbles.py.
	measure 'Bubble 07' = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='744' height='265'><defs><filter id='s' x='-20%' y='-20%' width='140%' height='140%'><feDropShadow dx='0' dy='3' stdDeviation='6' flood-color='#000' flood-opacity='0.55'/></filter></defs><path d='M 14 0 L 730 0 A 14 14 0 0 1 744 14 L 744 233 A 14 14 0 0 1 730 247 L 226 247 L 208 265 L 190 247 L 14 247 A 14 14 0 0 1 0 233 L 0 14 A 14 14 0 0 1 14 0 Z' fill='#221E1A' stroke='#C7A726' stroke-width='2' filter='url(#s)'/><foreignObject x='22' y='22' width='700' height='203'><div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI,Segoe,sans-serif;color:#CDC2B4;font-size:13px;line-height:1.5'><div style='color:#9E9285;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;margin-bottom:5px'>Step 2 of 2</div><div style='color:#C7A726;font-size:17px;font-weight:600;line-height:1.25;margin-bottom:9px'>Every ware, with its place in the tail</div><div>The same twenty-four wares as numbers. Elixir of Vitality alone is 20.2% of everything; the bottom thirteen together are under twenty.<br/><br/>Avg price is Gold per unit - a blended price across whatever is filtered, not a list price. There is no price column in the model.</div></div></foreignObject></svg>"
		displayFolder: Tutorial
		lineageTag: d07791ac-63a6-4883-bccb-e79b7f6aa5a5
		dataCategory: ImageUrl

	/// Coach-mark bubble. GENERATED by build_bubbles.py.
	measure 'Bubble 08' = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='592' height='187'><defs><filter id='s' x='-20%' y='-20%' width='140%' height='140%'><feDropShadow dx='0' dy='3' stdDeviation='6' flood-color='#000' flood-opacity='0.55'/></filter></defs><path d='M 32 0 L 578 0 A 14 14 0 0 1 592 14 L 592 173 A 14 14 0 0 1 578 187 L 32 187 A 14 14 0 0 1 18 173 L 18 74 L 0 56 L 18 38 L 18 14 A 14 14 0 0 1 32 0 Z' fill='#221E1A' stroke='#C7A726' stroke-width='2' filter='url(#s)'/><foreignObject x='40' y='22' width='530' height='143'><div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI,Segoe,sans-serif;color:#CDC2B4;font-size:13px;line-height:1.5'><div style='color:#9E9285;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;margin-bottom:5px'>Step 1 of 3</div><div style='color:#C7A726;font-size:17px;font-weight:600;line-height:1.25;margin-bottom:9px'>Gold by kind of patron</div><div>Four kinds, pinned at 40/25/20/15. Adventurers are the biggest block of Gold and nobles the smallest - the opposite of the clich&#233;, and entirely deliberate.</div></div></foreignObject></svg>"
		displayFolder: Tutorial
		lineageTag: 39f41af8-6126-49a2-8afe-afd399654065
		dataCategory: ImageUrl

	/// Coach-mark bubble, tail on the RIGHT. GENERATED by build_bubbles.py.
	measure 'Bubble 09' = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='576' height='241'><defs><filter id='s' x='-20%' y='-20%' width='140%' height='140%'><feDropShadow dx='0' dy='3' stdDeviation='6' flood-color='#000' flood-opacity='0.55'/></filter></defs><path d='M 14 0 L 544 0 A 14 14 0 0 1 558 14 L 558 54 L 576 72 L 558 90 L 558 227 A 14 14 0 0 1 544 241 L 14 241 A 14 14 0 0 1 0 227 L 0 14 A 14 14 0 0 1 14 0 Z' fill='#221E1A' stroke='#C7A726' stroke-width='2' filter='url(#s)'/><foreignObject x='22' y='22' width='514' height='197'><div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI,Segoe,sans-serif;color:#CDC2B4;font-size:13px;line-height:1.5'><div style='color:#9E9285;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;margin-bottom:5px'>Step 2 of 3</div><div style='color:#C7A726;font-size:17px;font-weight:600;line-height:1.25;margin-bottom:9px'>Average purse - the odd one</div><div>Adventurers have the <b>biggest</b> average purse (284) and nobles the smallest (190).<br/><br/>Every patron visits about as often as every other - roughly five thousand times over four years - so average purse has nothing left to track except the pinned Gold share. An artefact of the data, not a finding about nobles.</div></div></foreignObject></svg>"
		displayFolder: Tutorial
		lineageTag: 9062dee0-e2b7-4356-947d-c6f9831fd73d
		dataCategory: ImageUrl

	/// Coach-mark bubble. GENERATED by build_bubbles.py.
	measure 'Bubble 10' = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='696' height='221'><defs><filter id='s' x='-20%' y='-20%' width='140%' height='140%'><feDropShadow dx='0' dy='3' stdDeviation='6' flood-color='#000' flood-opacity='0.55'/></filter></defs><path d='M 14 0 L 682 0 A 14 14 0 0 1 696 14 L 696 189 A 14 14 0 0 1 682 203 L 296 203 L 278 221 L 260 203 L 14 203 A 14 14 0 0 1 0 189 L 0 14 A 14 14 0 0 1 14 0 Z' fill='#221E1A' stroke='#C7A726' stroke-width='2' filter='url(#s)'/><foreignObject x='22' y='22' width='652' height='159'><div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI,Segoe,sans-serif;color:#CDC2B4;font-size:13px;line-height:1.5'><div style='color:#9E9285;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;margin-bottom:5px'>Step 3 of 3</div><div style='color:#C7A726;font-size:17px;font-weight:600;line-height:1.25;margin-bottom:9px'>The big spenders</div><div>Kaelen Swiftblade alone is 24.1% of everything - more than the whole Noble kind put together.<br/><br/>The generator ranks big spenders first <b>within</b> each kind, so the pareto runs inside the type rather than across it.</div></div></foreignObject></svg>"
		displayFolder: Tutorial
		lineageTag: c87ccaf4-b840-4068-8fce-e9c57dcd0d45
		dataCategory: ImageUrl

	/// Coach-mark bubble for tutorial step 01. GENERATED by build_bubbles.py.
	measure 'Bubble 01' = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='680' height='261'><defs><filter id='s' x='-20%' y='-20%' width='140%' height='140%'><feDropShadow dx='0' dy='3' stdDeviation='6' flood-color='#000' flood-opacity='0.55'/></filter></defs><path d='M 14 18 L 90 18 L 108 0 L 126 18 L 666 18 A 14 14 0 0 1 680 32 L 680 247 A 14 14 0 0 1 666 261 L 14 261 A 14 14 0 0 1 0 247 L 0 32 A 14 14 0 0 1 14 18 Z' fill='#221E1A' stroke='#C7A726' stroke-width='2' filter='url(#s)'/><foreignObject x='22' y='40' width='636' height='199'><div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI,Segoe,sans-serif;color:#CDC2B4;font-size:13px;line-height:1.5'><div style='color:#9E9285;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;margin-bottom:5px'>Step 1 of 3</div><div style='color:#C7A726;font-size:17px;font-weight:600;line-height:1.25;margin-bottom:9px'>The headline numbers</div><div>25.00M is the four-year take. The generator was told to hit exactly 25,000,000 and landed on 25,000,000.76.<br/><br/>Growth reads +12.0% and it is fussier than it looks: the obvious measure compares 2023-2026 against 2023-2025 and reports +41.6%. That is arithmetic, not growth. This card always answers <b>how did the most recent year do</b>.</div></div></foreignObject></svg>"
		displayFolder: Tutorial
		lineageTag: 68791f93-3fc4-4ab0-b170-8368228510f2
		dataCategory: ImageUrl

	column _
		lineageTag: 7ad111fa-b0b7-4edd-a2b7-b1e2359e546d
		isNameInferred
		sourceColumn: [_]

	partition _Measures = calculated
		mode: import
		source = ROW ( "_", "" )

