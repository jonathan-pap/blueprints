{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "<VISUAL_NAME>",
  "position": { "x": 24, "y": 24, "z": 0, "height": 648, "width": 1232, "tabOrder": 0 },
  "visual": {
    "visualType": "lineStackedColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            { "field": { "Column": { "Expression": { "SourceRef": { "Entity": "<STEPS_TABLE>" } }, "Property": "Step" } }, "queryRef": "<STEPS_TABLE>.Step", "nativeQueryRef": "Step", "active": true }
          ]
        },
        "Y": {
          "projections": [
            { "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "<MEASURE_TABLE>" } }, "Property": "<PREFIX> Base" } }, "queryRef": "<MEASURE_TABLE>.<PREFIX> Base", "nativeQueryRef": "<PREFIX> Base" },
            { "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "<MEASURE_TABLE>" } }, "Property": "<PREFIX> Body · <STEP_1_NAME>" } }, "queryRef": "<MEASURE_TABLE>.<PREFIX> Body · <STEP_1_NAME>", "nativeQueryRef": "<PREFIX> Body · <STEP_1_NAME>" }
            /* ... ONE Y projection per body measure (one per step) ... */
          ]
        },
        "Y2": {
          "projections": [
            { "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "<MEASURE_TABLE>" } }, "Property": "<PREFIX> Label Anchor" } }, "queryRef": "<MEASURE_TABLE>.<PREFIX> Label Anchor", "nativeQueryRef": "<PREFIX> Label Anchor" }
          ]
        }
      }
    },
    "objects": {
      "layout": [{ "properties": { "stackedGapSize": { "expr": { "Literal": { "Value": "2D" } } } } }],
      "dataPoint": [
        { "properties": { "fillTransparency": { "expr": { "Literal": { "Value": "100D" } } } }, "selector": { "metadata": "<MEASURE_TABLE>.<PREFIX> Base" } },
        { "properties": { "fill": { "solid": { "color": { "expr": { "Literal": { "Value": "'<COLOR_TOTAL_START>'" } } } } } }, "selector": { "metadata": "<MEASURE_TABLE>.<PREFIX> Body · <STEP_1_NAME>" } }
        /* ... one fill color per body measure (drops get drop colors, totals get total colors) ... */ ,
        { "properties": { "fillTransparency": { "expr": { "Literal": { "Value": "100D" } } } }, "selector": { "metadata": "<MEASURE_TABLE>.<PREFIX> Label Anchor" } }
      ],
      "valueAxis": [{ "properties": {
        "show": { "expr": { "Literal": { "Value": "false" } } },
        "showAxisTitle": { "expr": { "Literal": { "Value": "false" } } },
        "start": { "expr": { "Literal": { "Value": "0D" } } },
        "end": { "expr": { "Measure": { "Expression": { "SourceRef": { "Entity": "<MEASURE_TABLE>" } }, "Property": "<PREFIX> Axis Max" } } },
        "secStart": { "expr": { "Literal": { "Value": "0D" } } },
        "secShow": { "expr": { "Literal": { "Value": "false" } } },
        "alignZeros": { "expr": { "Literal": { "Value": "true" } } }
      } }],
      "categoryAxis": [{ "properties": { "show": { "expr": { "Literal": { "Value": "true" } } }, "showAxisTitle": { "expr": { "Literal": { "Value": "false" } } } } }],
      "legend": [{ "properties": { "show": { "expr": { "Literal": { "Value": "false" } } } } }],
      "labels": [
        { "properties": { "show": { "expr": { "Literal": { "Value": "true" } } }, "fontFamily": { "expr": { "Literal": { "Value": "'wf_standard-font, helvetica, arial, sans-serif'" } } }, "fontSize": { "expr": { "Literal": { "Value": "9D" } } }, "labelPosition": { "expr": { "Literal": { "Value": "'InsideEnd'" } } }, "enableValueDataLabel": { "expr": { "Literal": { "Value": "false" } } } } },
        { "properties": { "dynamicLabelValue": { "expr": { "Measure": { "Expression": { "SourceRef": { "Entity": "<MEASURE_TABLE>" } }, "Property": "<PREFIX> Label" } } } }, "selector": { "data": [{ "dataViewWildcard": { "matchingOption": 1 } }], "metadata": "<MEASURE_TABLE>.<PREFIX> Body · <STEP_1_NAME>", "highlightMatching": 1 } }
        /* ... one dynamic-label entry per body measure (substitute <PREFIX> Label (rich) for detailed variant) ... */ ,
        { "properties": { "enableValueDataLabel": { "expr": { "Literal": { "Value": "true" } } }, "enableBackground": { "expr": { "Literal": { "Value": "false" } } } }, "selector": { "metadata": "<MEASURE_TABLE>.<PREFIX> Label Anchor" } },
        { "properties": { "dynamicLabelValue": { "expr": { "Measure": { "Expression": { "SourceRef": { "Entity": "<MEASURE_TABLE>" } }, "Property": "<PREFIX> Label" } } } }, "selector": { "data": [{ "dataViewWildcard": { "matchingOption": 1 } }], "metadata": "<MEASURE_TABLE>.<PREFIX> Label Anchor", "highlightMatching": 1 } }
        /* DO NOT add { "showSeries": false } for <PREFIX> Label Anchor — see [[pbi-labels-showseries-trap]] */
      ],
      "lineStyles": [{ "properties": { "showMarker": { "expr": { "Literal": { "Value": "false" } } }, "strokeTransparency": { "expr": { "Literal": { "Value": "100D" } } } } }]
    },
    "visualContainerObjects": {
      "title": [{ "properties": { "show": { "expr": { "Literal": { "Value": "true" } } }, "text": { "expr": { "Literal": { "Value": "'<PAGE_DISPLAY_NAME>'" } } }, "fontSize": { "expr": { "Literal": { "Value": "14D" } } } } }]
    },
    "drillFilterOtherVisuals": true
  }
}
